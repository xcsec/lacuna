+/// LACUNA — generic ExecutionRecord field perturbation (TEST-ONLY, default OFF).
+///
+/// The write-back hook in `sp1_core_executor::wb_perturb` covers every value an
+/// instruction produces. This second hook covers record fields that no instruction
+/// write-back produces: it rewrites one field of one already-generated
+/// [`ExecutionRecord`] just before `generate_dependencies` runs, so the dependent
+/// byte/range events and every chip trace are regenerated from the rewritten record.
+///
+/// Default OFF: `apply` returns immediately unless armed, so no honest behaviour and
+/// no constraint is affected.
+pub mod record_perturb {
+    use super::ExecutionRecord;
+    use std::sync::atomic::{AtomicBool, AtomicI64, AtomicU64, AtomicUsize, Ordering};
+    const R: Ordering = Ordering::Relaxed;
+
+    /// `global_memory_initialize_events[k].value`
+    pub const F_MEM_INIT_VALUE: usize = 0;
+    /// `global_memory_finalize_events[k].value`
+    pub const F_MEM_FINAL_VALUE: usize = 1;
+
+    /// v ^ (1 << i)
+    pub const MU_XORBIT: usize = 0;
+    /// v + k (wrapping)
+    pub const MU_ADDK: usize = 1;
+    /// v <- 0
+    pub const MU_ZERO: usize = 2;
+    /// v <- literal
+    pub const MU_SET: usize = 3;
+
+    static ENABLED: AtomicBool = AtomicBool::new(false);
+    static FIELD: AtomicUsize = AtomicUsize::new(F_MEM_INIT_VALUE);
+    /// Which entry of the (globally indexed, addr-ordered) event list to rewrite.
+    static TARGET_IDX: AtomicI64 = AtomicI64::new(-1);
+    static SEEN: AtomicI64 = AtomicI64::new(0);
+    static MU_KIND: AtomicUsize = AtomicUsize::new(MU_XORBIT);
+    static MU_ARG: AtomicI64 = AtomicI64::new(0);
+    static HITS: AtomicUsize = AtomicUsize::new(0);
+    static HONEST: AtomicU64 = AtomicU64::new(0);
+    static FORGED: AtomicU64 = AtomicU64::new(0);
+    static ADDR: AtomicU64 = AtomicU64::new(0);
+
+    /// Number of record fields actually rewritten (0 => the site did not exist).
+    #[must_use]
+    pub fn hits() -> usize {
+        HITS.load(R)
+    }
+    /// Honest value of the last rewritten field.
+    #[must_use]
+    pub fn honest_value() -> u64 {
+        HONEST.load(R)
+    }
+    /// Forged value of the last rewritten field.
+    #[must_use]
+    pub fn forged_value() -> u64 {
+        FORGED.load(R)
+    }
+    /// Address of the last rewritten event.
+    #[must_use]
+    pub fn addr() -> u64 {
+        ADDR.load(R)
+    }
+
+    /// Run `body` with the record field perturbed. Cleared on return or panic.
+    pub fn with<Res>(
+        field: usize,
+        idx: i64,
+        mu_kind: usize,
+        mu_arg: i64,
+        body: impl FnOnce() -> Res,
+    ) -> Res {
+        FIELD.store(field, R);
+        TARGET_IDX.store(idx, R);
+        SEEN.store(0, R);
+        MU_KIND.store(mu_kind, R);
+        MU_ARG.store(mu_arg, R);
+        HITS.store(0, R);
+        HONEST.store(0, R);
+        FORGED.store(0, R);
+        ADDR.store(0, R);
+        ENABLED.store(true, R);
+        struct Clear;
+        impl Drop for Clear {
+            fn drop(&mut self) {
+                ENABLED.store(false, R);
+                TARGET_IDX.store(-1, R);
+            }
+        }
+        let _c = Clear;
+        body()
+    }
+
+    #[inline]
+    fn mutate(v: u64) -> u64 {
+        let arg = MU_ARG.load(R);
+        match MU_KIND.load(R) {
+            MU_XORBIT => v ^ (1u64 << ((arg as u64) & 63)),
+            MU_ADDK => v.wrapping_add(arg as u64),
+            MU_ZERO => 0,
+            MU_SET => arg as u64,
+            _ => v,
+        }
+    }
+
+    /// Rewrite the armed field of `records`. No-op unless armed.
+    pub fn apply(records: &mut [ExecutionRecord]) {
+        if !ENABLED.load(R) {
+            return;
+        }
+        let field = FIELD.load(R);
+        let want = TARGET_IDX.load(R);
+        for record in records.iter_mut() {
+            let events = match field {
+                F_MEM_INIT_VALUE => &mut record.global_memory_initialize_events,
+                F_MEM_FINAL_VALUE => &mut record.global_memory_finalize_events,
+                _ => return,
+            };
+            for ev in events.iter_mut() {
+                let n = SEEN.fetch_add(1, R);
+                if want >= 0 && n != want {
+                    continue;
+                }
+                let f = mutate(ev.value);
+                if f == ev.value {
+                    continue;
+                }
+                HONEST.store(ev.value, R);
+                FORGED.store(f, R);
+                ADDR.store(ev.addr, R);
+                HITS.fetch_add(1, R);
+                ev.value = f;
+            }
+        }
+    }
+}
