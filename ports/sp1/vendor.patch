+/// LACUNA — generic record-layer write-back perturbation (TEST-ONLY, default OFF).
+///
+/// This is the SP1 analogue of the single architectural write-back choke point used
+/// on pico (`on_reg_write`, called from `rw()`) and on nexus
+/// (`wb_perturb::on_write_back`, called from `trace::step`).
+///
+/// In SP1 the record-producing executor is [`CoreVM`] (re-executed over the minimal
+/// trace by `TracingVM`), and *every* architectural register write-back — ALU,
+/// load, jump, U-type and ecall — funnels through [`CoreVM::rw`]. Arming this
+/// module rewrites the value at one static pc: the rewritten value lands in
+/// `self.registers` (so the rest of the honest execution continues from it) and in
+/// the returned `MemoryWriteRecord` (so the memory-consistency record follows), and
+/// `sync()` is used at the event-emission sites so the typed event's `a` field stays
+/// coherent with the register write.
+///
+/// It contains no opcode, operand, chip or column knowledge: the arming key is
+/// `(static pc, n-th execution of that pc)` and the rewriting menu is
+/// instruction-independent.
+pub mod wb_perturb {
+    use std::sync::atomic::{AtomicBool, AtomicI64, AtomicU64, AtomicUsize, Ordering};
+    const R: Ordering = Ordering::Relaxed;
+
+    /// v ^ (1 << i)
+    pub const MU_XORBIT: usize = 0;
+    /// v + k (wrapping); k = +/- B^i expresses the scalar-result template
+    pub const MU_ADDK: usize = 1;
+    /// v <- 0
+    pub const MU_ZERO: usize = 2;
+    /// v <- literal (boundary values)
+    pub const MU_SET: usize = 3;
+
+    static ENABLED: AtomicBool = AtomicBool::new(false);
+    static TARGET_PC: AtomicU64 = AtomicU64::new(u64::MAX);
+    static TARGET_NTH: AtomicI64 = AtomicI64::new(-1);
+    static SEEN: AtomicI64 = AtomicI64::new(0);
+    static MU_KIND: AtomicUsize = AtomicUsize::new(MU_XORBIT);
+    static MU_ARG: AtomicI64 = AtomicI64::new(0);
+    static HITS: AtomicUsize = AtomicUsize::new(0);
+    static HONEST: AtomicU64 = AtomicU64::new(0);
+    static FORGED: AtomicU64 = AtomicU64::new(0);
+
+    /// Number of write-backs actually perturbed (0 => the site never executed).
+    #[must_use]
+    pub fn hits() -> usize {
+        HITS.load(R)
+    }
+
+    /// The honest value of the last perturbed write-back.
+    #[must_use]
+    pub fn honest_value() -> u64 {
+        HONEST.load(R)
+    }
+
+    /// The forged value of the last perturbed write-back.
+    #[must_use]
+    pub fn forged_value() -> u64 {
+        FORGED.load(R)
+    }
+
+    /// Is the hook currently armed?
+    #[must_use]
+    pub fn armed() -> bool {
+        ENABLED.load(R)
+    }
+
+    /// Run `body` with the write-back at `pc` perturbed by `mu`. Cleared on return
+    /// or panic. `nth < 0` arms every execution of that static pc.
+    pub fn with<Res>(
+        pc: u64,
+        nth: i64,
+        mu_kind: usize,
+        mu_arg: i64,
+        body: impl FnOnce() -> Res,
+    ) -> Res {
+        TARGET_PC.store(pc, R);
+        TARGET_NTH.store(nth, R);
+        SEEN.store(0, R);
+        MU_KIND.store(mu_kind, R);
+        MU_ARG.store(mu_arg, R);
+        HITS.store(0, R);
+        HONEST.store(0, R);
+        FORGED.store(0, R);
+        ENABLED.store(true, R);
+        struct Clear;
+        impl Drop for Clear {
+            fn drop(&mut self) {
+                ENABLED.store(false, R);
+                TARGET_PC.store(u64::MAX, R);
+            }
+        }
+        let _c = Clear;
+        body()
+    }
+
+    #[inline]
+    fn mutate(v: u64) -> u64 {
+        let arg = MU_ARG.load(R);
+        match MU_KIND.load(R) {
+            MU_XORBIT => v ^ (1u64 << ((arg as u64) & 63)),
+            MU_ADDK => v.wrapping_add(arg as u64),
+            MU_ZERO => 0,
+            MU_SET => arg as u64,
+            _ => v,
+        }
+    }
+
+    /// THE choke point: called from `CoreVM::rw` with the value the instruction
+    /// wrote back. Returns the value to record.
+    #[inline]
+    pub fn on_write_back(pc: u64, v: u64) -> u64 {
+        if !ENABLED.load(R) || pc != TARGET_PC.load(R) {
+            return v;
+        }
+        let n = SEEN.fetch_add(1, R);
+        let want = TARGET_NTH.load(R);
+        if want >= 0 && n != want {
+            return v;
+        }
+        let f = mutate(v);
+        if f == v {
+            return v;
+        }
+        HONEST.store(v, R);
+        FORGED.store(f, R);
+        HITS.fetch_add(1, R);
+        f
+    }
+
+    /// Keep a typed event's `a` field coherent with the (possibly perturbed)
+    /// register write record. When the hook is disarmed this is the identity on
+    /// `honest`, so no honest behaviour and no constraint changes.
+    #[inline]
+    #[must_use]
+    pub fn sync(honest: u64, recorded: u64) -> u64 {
+        if ENABLED.load(R) {
+            recorded
+        } else {
+            honest
+        }
+    }
+}
