+/// LACUNA — generic record-layer write-back perturbation (TEST-ONLY, default OFF).
+///
+/// ceno's single architectural write-back choke point is
+/// [`VMState::store_register`] (this file): every instruction that produces an
+/// architectural result — compute, load, jal/jalr, lui/auipc, and the ecall
+/// RD_NULL dark write — funnels through it, and it is the one place that both
+///
+///   * hands the value to the tracer (`tracer.store_register` -> `StepRecord.rd`,
+///     which is what `Instruction::assign_instance` later consumes), and
+///   * updates the architectural register file,
+///
+/// so rewriting the value here makes the honest emulator continue from the
+/// perturbed value: every later register read, dependent store, memory record and
+/// public commit follows naturally, exactly as the honest pipeline would.
+///
+/// The module contains no opcode, operand, chip or column knowledge: the arming
+/// key is `(static pc, n-th execution of that pc)` and the rewriting menu is
+/// instruction-independent. Default OFF; it changes no constraint.
+pub mod wb_perturb {
+    use std::sync::atomic::{AtomicBool, AtomicI64, AtomicU32, AtomicU64, AtomicUsize, Ordering};
+    const R: Ordering = Ordering::Relaxed;
+
+    /// v ^ (1 << i)
+    pub const MU_XORBIT: usize = 0;
+    /// v + k  (wrapping); k = +/- B^i expresses the scalar-result template
+    pub const MU_ADDK: usize = 1;
+    /// v <- 0
+    pub const MU_ZERO: usize = 2;
+    /// v <- literal (boundary values)
+    pub const MU_SET: usize = 3;
+
+    static ENABLED: AtomicBool = AtomicBool::new(false);
+    static TARGET_PC: AtomicU32 = AtomicU32::new(u32::MAX);
+    static TARGET_NTH: AtomicI64 = AtomicI64::new(-1);
+    static SEEN: AtomicI64 = AtomicI64::new(0);
+    static MU_KIND: AtomicUsize = AtomicUsize::new(MU_XORBIT);
+    static MU_ARG: AtomicI64 = AtomicI64::new(0);
+    static HITS: AtomicUsize = AtomicUsize::new(0);
+    static HONEST: AtomicU64 = AtomicU64::new(0);
+    static FORGED: AtomicU64 = AtomicU64::new(0);
+
+    /// Number of write-backs actually perturbed (0 => the site never executed).
+    pub fn hits() -> usize {
+        HITS.load(R)
+    }
+    pub fn honest_value() -> u32 {
+        HONEST.load(R) as u32
+    }
+    pub fn forged_value() -> u32 {
+        FORGED.load(R) as u32
+    }
+    /// Reset the per-run counters without disarming (the ceno pipeline emulates the
+    /// same program more than once inside one armed scope: the preflight pass and
+    /// the witness replay).
+    pub fn reset_counters() {
+        SEEN.store(0, R);
+        HITS.store(0, R);
+    }
+
+    /// Run `body` with the write-back at `pc` perturbed by `mu`. Cleared on return
+    /// or panic.
+    pub fn with<Res>(
+        pc: u32,
+        nth: i64,
+        mu_kind: usize,
+        mu_arg: i64,
+        body: impl FnOnce() -> Res,
+    ) -> Res {
+        TARGET_PC.store(pc, R);
+        TARGET_NTH.store(nth, R);
+        SEEN.store(0, R);
+        MU_KIND.store(mu_kind, R);
+        MU_ARG.store(mu_arg, R);
+        HITS.store(0, R);
+        HONEST.store(0, R);
+        FORGED.store(0, R);
+        ENABLED.store(true, R);
+        struct Clear;
+        impl Drop for Clear {
+            fn drop(&mut self) {
+                ENABLED.store(false, R);
+                TARGET_PC.store(u32::MAX, R);
+            }
+        }
+        let _c = Clear;
+        body()
+    }
+
+    #[inline]
+    fn mutate(v: u32) -> u32 {
+        let arg = MU_ARG.load(R);
+        match MU_KIND.load(R) {
+            MU_XORBIT => v ^ (1u32 << ((arg as u32) & 31)),
+            MU_ADDK => v.wrapping_add(arg as u32),
+            MU_ZERO => 0,
+            MU_SET => arg as u32,
+            _ => v,
+        }
+    }
+
+    /// THE choke point: called once per architectural register write-back with the
+    /// value the instruction produced. Returns the value to record AND to commit to
+    /// the register file.
+    #[inline(always)]
+    pub fn on_write_back(pc: u32, v: u32) -> u32 {
+        if !ENABLED.load(R) || pc != TARGET_PC.load(R) {
+            return v;
+        }
+        let n = SEEN.fetch_add(1, R);
+        let want = TARGET_NTH.load(R);
+        if want >= 0 && n != want {
+            return v;
+        }
+        let f = mutate(v);
+        if f == v {
+            return v;
+        }
+        HONEST.store(v as u64, R);
+        FORGED.store(f as u64, R);
+        HITS.fetch_add(1, R);
+        f
+    }
+}
