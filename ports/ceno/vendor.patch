+/// LACUNA — generic record-layer ORDER (timestamp) perturbation (TEST-ONLY, default OFF).
+///
+/// `FullTracer::track_access` is the single point at which the *previous access
+/// cycle* that lands in a `StepRecord` op (`rs1/rs2/rd/memory_op.previous_cycle`)
+/// is produced. That field is a genuine single-point record hook: it feeds the
+/// `prev_ts` witness column, the `lt_cfg` AssertLt and the `shard_ctx.send` RAM
+/// record (ceno_zkvm/src/instructions/riscv/insn_base.rs:124,127-132,133-141).
+///
+/// Rewriting it here changes ONLY the recorded field; `latest_accesses` keeps the
+/// honest chain, so the rest of the execution is untouched. Arming key is
+/// `(static pc, subcycle, n-th)`; the menu is instruction-independent.
+/// Default OFF; it changes no constraint.
+pub mod ts_perturb {
+    use super::Cycle;
+    use std::sync::atomic::{AtomicBool, AtomicI64, AtomicU32, AtomicU64, AtomicUsize, Ordering};
+    const R: Ordering = Ordering::Relaxed;
+
+    /// prev + k (saturating at 0)
+    pub const MU_ADDK: usize = 1;
+    /// prev <- 0
+    pub const MU_ZERO: usize = 2;
+    /// prev <- literal
+    pub const MU_SET: usize = 3;
+
+    static ENABLED: AtomicBool = AtomicBool::new(false);
+    static TARGET_PC: AtomicU32 = AtomicU32::new(u32::MAX);
+    /// -1 = any subcycle
+    static TARGET_SUB: AtomicI64 = AtomicI64::new(-1);
+    static TARGET_NTH: AtomicI64 = AtomicI64::new(-1);
+    static SEEN: AtomicI64 = AtomicI64::new(0);
+    static MU_KIND: AtomicUsize = AtomicUsize::new(MU_ADDK);
+    static MU_ARG: AtomicI64 = AtomicI64::new(0);
+    static HITS: AtomicUsize = AtomicUsize::new(0);
+    static HONEST: AtomicU64 = AtomicU64::new(0);
+    static FORGED: AtomicU64 = AtomicU64::new(0);
+
+    pub fn hits() -> usize {
+        HITS.load(R)
+    }
+    pub fn honest_value() -> u64 {
+        HONEST.load(R)
+    }
+    pub fn forged_value() -> u64 {
+        FORGED.load(R)
+    }
+
+    pub fn with<Res>(
+        pc: u32,
+        subcycle: i64,
+        nth: i64,
+        mu_kind: usize,
+        mu_arg: i64,
+        body: impl FnOnce() -> Res,
+    ) -> Res {
+        TARGET_PC.store(pc, R);
+        TARGET_SUB.store(subcycle, R);
+        TARGET_NTH.store(nth, R);
+        SEEN.store(0, R);
+        MU_KIND.store(mu_kind, R);
+        MU_ARG.store(mu_arg, R);
+        HITS.store(0, R);
+        HONEST.store(0, R);
+        FORGED.store(0, R);
+        ENABLED.store(true, R);
+        struct Clear;
+        impl Drop for Clear {
+            fn drop(&mut self) {
+                ENABLED.store(false, R);
+                TARGET_PC.store(u32::MAX, R);
+            }
+        }
+        let _c = Clear;
+        body()
+    }
+
+    #[inline]
+    fn mutate(v: Cycle) -> Cycle {
+        let arg = MU_ARG.load(R);
+        match MU_KIND.load(R) {
+            MU_ADDK => {
+                if arg >= 0 {
+                    v.saturating_add(arg as u64)
+                } else {
+                    v.saturating_sub((-arg) as u64)
+                }
+            }
+            MU_ZERO => 0,
+            MU_SET => arg as u64,
+            _ => v,
+        }
+    }
+
+    /// THE choke point for the ORDER family.
+    #[inline(always)]
+    pub fn on_prev_cycle(pc: u32, subcycle: Cycle, prev: Cycle) -> Cycle {
+        if !ENABLED.load(R) || pc != TARGET_PC.load(R) {
+            return prev;
+        }
+        let want_sub = TARGET_SUB.load(R);
+        if want_sub >= 0 && subcycle != want_sub as u64 {
+            return prev;
+        }
+        let n = SEEN.fetch_add(1, R);
+        let want = TARGET_NTH.load(R);
+        if want >= 0 && n != want {
+            return prev;
+        }
+        let f = mutate(prev);
+        if f == prev {
+            return prev;
+        }
+        HONEST.store(prev, R);
+        FORGED.store(f, R);
+        HITS.fetch_add(1, R);
+        f
+    }
+}
