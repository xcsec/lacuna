+    /// Honest ltguest records (executor forge OFF) with extra records applied.
+    fn ltguest_honest_records(
+        chips: &[crate::machine::chip::MetaChip<F, C>],
+        opts: EmulatorOpts,
+    ) -> Vec<crate::emulator::riscv::record::EmulationRecord> {
