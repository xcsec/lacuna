+// ============================================================================
+// SOUNDNESS POCs (forged-witness demonstrations)
+//
+// These tests run the full STARK prove/verify path (test_no_lookup chips, so
+// only each chip's OWN algebraic AIR constraints are enforced) and MUTATE one
+// cell of the LessThan chip's main trace AFTER trace generation, then check
+// whether the proof still verifies.
+//
+// C1 — SLT/SLTU FREE OUTPUT.
+//   lt/constraints.rs:45-48 asserts a[1]==a[2]==a[3]==0 but NEVER binds a[0]
+//   to lt_signed.result.bit, and a[0] is not even constrained boolean. So a
+//   prover may write ANY value into a[0] (the SLT/SLTU destination low limb).
+// ============================================================================
+
+use crate::{
+    chips::{
+        chips::{
+            alu::lt::columns::{LtCols, NUM_LT_COLS},
+            riscv_memory::initialize_finalize::{MemoryChipType, MemoryInitializeFinalizeChip},
+        },
+        tests::test_rv64_emulate,
+    },
+    configs::{config::StarkGenericConfig, stark_config::KoalaBearPoseidon2},
+    emulator::stdin::EmulatorStdin,
+    instances::{chiptype::riscv_chiptype::RiscvChipType, machine::simple::SimpleMachine},
+    machine::{chip::MetaChip, machine::MachineBehavior, prover::BaseProver},
+    primitives::consts::RISCV_NUM_PVS,
+};
+use core::borrow::BorrowMut;
+use p3_koala_bear::KoalaBear;
+use std::sync::Arc;
+
+/// Build the standard test_no_lookup chip list (mirrors chips::tests::run_test).
+fn standard_chips() -> Vec<MetaChip<KoalaBear, RiscvChipType<KoalaBear>>> {
+    vec![
+        MetaChip::test_no_lookup(RiscvChipType::<KoalaBear>::Program(Default::default())),
+        MetaChip::test_no_lookup(RiscvChipType::<KoalaBear>::Mul(Default::default())),
+        MetaChip::test_no_lookup(RiscvChipType::<KoalaBear>::DivRem(Default::default())),
+        MetaChip::test_no_lookup(RiscvChipType::<KoalaBear>::Add(Default::default())),
+        MetaChip::test_no_lookup(RiscvChipType::<KoalaBear>::Sub(Default::default())),
+        MetaChip::test_no_lookup(RiscvChipType::<KoalaBear>::Addw(Default::default())),
+        MetaChip::test_no_lookup(RiscvChipType::<KoalaBear>::Subw(Default::default())),
+        MetaChip::test_no_lookup(RiscvChipType::<KoalaBear>::SR(Default::default())),
+        MetaChip::test_no_lookup(RiscvChipType::<KoalaBear>::Lt(Default::default())),
+        MetaChip::test_no_lookup(RiscvChipType::<KoalaBear>::MemoryReadWrite(
+            Default::default(),
+        )),
+        MetaChip::test_no_lookup(RiscvChipType::<KoalaBear>::MemoryLocal(Default::default())),
+        MetaChip::test_no_lookup(RiscvChipType::<KoalaBear>::MemoryInitialize(
+            MemoryInitializeFinalizeChip::new(MemoryChipType::Initialize),
+        )),
+        MetaChip::test_no_lookup(RiscvChipType::<KoalaBear>::MemoryFinalize(
+            MemoryInitializeFinalizeChip::new(MemoryChipType::Finalize),
+        )),
+    ]
+}
+
+/// Prove+verify, but first call `forge` on the main trace of the chip whose
+/// `name()` == `target_chip`. Returns `Ok(())` if the proof verifies, else the
+/// verification error message.
+fn forge_prove_verify<Forge>(
+    program: Arc<Program>,
+    chips: Vec<MetaChip<KoalaBear, RiscvChipType<KoalaBear>>>,
+    record: crate::emulator::riscv::record::EmulationRecord,
+    target_chip: &str,
+    forge: Forge,
+) -> Result<(), String>
+where
+    Forge: FnOnce(&mut p3_matrix::dense::RowMajorMatrix<KoalaBear>),
+{
+    let config = KoalaBearPoseidon2::test();
+    let machine = SimpleMachine::new(config.clone(), chips, RISCV_NUM_PVS);
+
+    let prover = BaseProver::new();
+    let (pk, vk) = prover.setup_keys(&config, &machine.base_machine().chips(), &program);
+
+    let mut chips_and_main = prover.generate_main(&machine.base_machine().chips(), &record);
+
+    // Locate and mutate the target chip's main trace.
+    let idx = chips_and_main
+        .iter()
+        .position(|(name, _)| name == target_chip)
+        .unwrap_or_else(|| {
+            let names: Vec<&String> = chips_and_main.iter().map(|(n, _)| n).collect();
+            panic!("target chip {target_chip} not found in main traces; have {names:?}")
+        });
+    forge(&mut chips_and_main[idx].1);
+
+    // The pico verifier `panic!`s (verifier.rs:383 "Constraint verification failed")
+    // instead of returning Err, and the prover may also panic when committing an
+    // unsatisfiable quotient. Catch any panic so a rejected forgery is reported as
+    // Err rather than aborting the test. Silence the default panic hook so the
+    // expected-failure output stays clean.
+    let prev_hook = std::panic::take_hook();
+    std::panic::set_hook(Box::new(|_| {}));
+    let outcome = std::panic::catch_unwind(std::panic::AssertUnwindSafe(|| {
+        let main_commitment = prover
+            .commit_main(&config, &record, chips_and_main)
+            .expect("should have main commitment");
+
+        let mut challenger = config.challenger();
+        pk.observed_by(&mut challenger);
+
+        let proof = prover.prove(
+            &config,
+            &machine.base_machine().chips(),
+            &pk,
+            main_commitment,
+            &mut challenger,
+            0,
+            RISCV_NUM_PVS,
+        );
+
+        let meta_proof = crate::machine::proof::MetaProof::new(
+            vec![proof].into(),
+            vec![vk.clone()].into(),
+            None,
+        );
+
+        machine
+            .verify(&meta_proof, &vk)
+            .map_err(|e| format!("{e:?}"))
+    }));
+    std::panic::set_hook(prev_hook);
+
+    match outcome {
+        Ok(r) => r,
+        Err(p) => {
+            let msg = p
+                .downcast_ref::<String>()
+                .cloned()
+                .or_else(|| p.downcast_ref::<&str>().map(|s| s.to_string()))
+                .unwrap_or_else(|| "panic (unknown payload)".to_string());
+            Err(format!("panic: {msg}"))
+        }
+    }
+}
