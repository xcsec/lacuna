+#[test]
+fn c1_slt_free_output_forge_accepted() {
+    // Honest: x12 = (10 < 3) = 0, so a = [0,0,0,0].
+    // FORGE: set a[0] = 1 → claims (10 < 3) == 1. Constraints never bind a[0].
+    let program = Arc::new(create_slt_program());
+    let chips = standard_chips();
+    let record = emulate_first_record(program.clone(), &chips);
+
+    let res = forge_prove_verify(program, chips, record, "LessThan", |trace| {
+        set_lt_a(trace, 0, 1); // forge SLT result low limb 0 -> 1
+    });
+    println!("C1 forge (a[0]=1) verify result: {res:?}");
+    assert!(
+        res.is_ok(),
+        "C1 BUG REFUTED: forging SLT output a[0]=1 was rejected: {res:?}"
+    );
+    println!("C1 ACCEPTED-FORGERY: SLT can output an arbitrary boolean (a[0] unconstrained).");
+}
+
+#[test]
+fn c1_slt_neg_control_a1_fails() {
+    // NEG CONTROL: a[1] IS asserted zero (constraints.rs:46). Forging a[1]=1 must FAIL.
+    let program = Arc::new(create_slt_program());
+    let chips = standard_chips();
+    let record = emulate_first_record(program.clone(), &chips);
+
+    let res = forge_prove_verify(program, chips, record, "LessThan", |trace| {
+        set_lt_a(trace, 1, 1); // forge asserted-zero limb a[1] -> 1
+    });
+    println!("C1 neg-control (a[1]=1) verify result: {res:?}");
+    assert!(
+        res.is_err(),
+        "C1 NEG-CONTROL BROKEN: forging asserted-zero a[1] unexpectedly verified"
+    );
+    println!("C1 NEG-CONTROL OK: forging asserted-zero a[1] correctly rejected.");
+}
