+        // Honest baseline: no executor forge, hook only measures the SR-chunk balance.
+        let honest_hook: forge_hook::Hook = {
+            let pk = pk_arc.clone();
+            let chips = chips_arc.clone();
+            Box::new(move |traces: &mut Vec<(String, RowMajorMatrix<F>)>| {
+                if !traces.iter().any(|(n, _)| n == "ShiftRight") {
+                    return;
+                }
+                let bal = regional_balance_from_mut_traces(&pk, &chips, traces.as_slice());
+                let nz = bal.values().filter(|v| !v.is_zero()).count();
+                eprintln!("[N2 HONEST-HOOK] ShiftRight chunk nonzero regional keys = {nz}");
+                for (k, v) in &bal {
+                    if !v.is_zero() {
