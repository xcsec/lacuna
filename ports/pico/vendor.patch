+    fn to_signed_kb(x: F) -> i64 {
+        use p3_field::PrimeField32;
+        let p: i64 = 2130706433; // KoalaBear prime = 2^31 - 2^24 + 1
+        let v = x.as_canonical_u32() as i64;
+        if v > p / 2 {
+            v - p
+        } else {
+            v
