+                .iter()
+                .filter(|((o, _), _)| *o == op)
+                .map(|((_, pc), n)| (*pc, *n))
+                .collect();
+            v.sort_by_key(|(_, n)| *n);
+            for (pc, _) in v.iter().take(2) {
+                sites.push((op, *pc));
+            }
+        }
