+        );
+        println!(
+            "E2E DIVU BOUNDARY FORGE ACCEPTED: verifier committed 8/2 = 3 (true 4) with ALL \
+             lookups ON. pico's DivRem `abs(rem) <= abs(c)` loose bound admits the boundary \
+             decomposition (q=3, r=divisor=2)."
+        );
+    }
+
+    // ========================================================================
+    // BUG (2) — pico MemoryFinalize sort-uniqueness (address-sort bit).
+    //
+    // The address-ordering `prev_addr < addr` is enforced by the SAME
+    // LtWordU16Gadget whose equal-case is admitted (all limb-flags 0, bit 0),
+    // so the sort is really `prev_addr <= addr` — duplicate / non-strict
+    // addresses pass the sort. That is a genuine AIR under-constraint. The
+    // question for the GOLD bar is whether it is *independently exploitable*
+    // into a verifier-accepted WRONG COMMITTED OUTPUT (read != last-write).
+    //
+    // This experiment forges a finalized memory VALUE (the finalized value IS
+    // the address's last-write value; changing it claims a different final
+    // memory state) via the forge_hook trace seam, leaving the sort columns
+    // untouched, and runs the GENUINE prove+verify to see exactly what rejects
+    // it. The finalize row RECEIVES (addr,value,ts) from the Global memory
+    // argument (is_receive=1); the last-write SENDS the true tuple. So the
+    // report tells us which argument pins the finalized value.
+    // ========================================================================
+
+    /// Forge the first real MemoryFinalize row's value word (value[0] += 1),
+    /// modelling "the prover claims a different final value for this address".
+    fn forge_memory_finalize_value(traces: &mut Vec<(String, RowMajorMatrix<F>)>) {
+        use crate::chips::chips::riscv_memory::initialize_finalize::columns::{
+            MemoryInitializeFinalizeCols, NUM_MEMORY_INITIALIZE_FINALIZE_COLS as NCOLS,
+        };
+        use p3_field::PrimeField32;
+        use p3_matrix::Matrix;
+
+        let Some(mi) = traces.iter().position(|(n, _)| n == "MemoryFinalize") else {
+            eprintln!("MEMFINAL-FORGE: no MemoryFinalize trace in this chunk");
+            return;
+        };
+        let trace = &mut traces[mi].1;
+        let height = trace.height();
+        for row in 0..height {
+            let base = row * NCOLS;
+            let slice = &mut trace.values[base..base + NCOLS];
+            let cols: &mut MemoryInitializeFinalizeCols<F> = slice.borrow_mut();
+            // Pick a real, comparison-enabled row with a nonzero value limb.
+            if cols.is_real == F::ONE && cols.value.0[0].as_canonical_u32() != 0 {
+                let old = cols.value.0[0].as_canonical_u32();
+                cols.value.0[0] = cols.value.0[0] + F::ONE;
+                eprintln!(
+                    "MEMFINAL-FORGE: row {row} addr_lo={} value[0] {old} -> {} (sort cols untouched)",
+                    cols.addr[0].as_canonical_u32(),
+                    cols.value.0[0].as_canonical_u32()
+                );
+                return;
+            }
+        }
+        eprintln!("MEMFINAL-FORGE: no suitable real finalize row found in this chunk");
+    }
+
+    #[test]
+    #[ignore = "BUG(2) experiment: MemoryFinalize value forge; report the blocking imbalance"]
+    fn e2e_memory_finalize_value_forge() {
+        crate::machine::logger::setup_logger();
+        let program = ltguest_program();
+        let machine = RiscvMachine::new(SC::test(), RiscvChipType::all_chips(), RISCV_NUM_PVS);
+        let (pk, vk) = machine.setup_keys(&program);
+
+        let hook: forge_hook::Hook = Box::new(forge_memory_finalize_value);
+        let res = forge_hook::with_hook(hook, || {
+            let witness = ProvingWitness::<SC, C, Vec<u8>>::setup_for_riscv(
+                program.clone(),
+                ltguest_stdin(),
+                EmulatorOpts::default(),
+                pk.clone(),
+                vk.clone(),
+            );
+            let (proof, _r) = machine.prove_with_shape_report(&witness, None);
+            let prev = std::panic::take_hook();
+            std::panic::set_hook(Box::new(|_| {}));
+            let res: Result<(), String> =
+                match std::panic::catch_unwind(std::panic::AssertUnwindSafe(|| {
+                    machine.verify(&proof, &vk)
+                })) {
+                    Ok(inner) => inner.map_err(|e| format!("{e:?}")),
+                    Err(_) => Err("verify panicked (bus/constraint failure)".to_string()),
+                };
+            std::panic::set_hook(prev);
+            res
+        });
+        println!("MEMFINAL value-forge verify: {res:?}");
+        // We EXPECT rejection: the finalized value is pinned by the Global memory
+        // argument, independent of the (weak) sort. This documents the blocker.
+        assert!(
+            res.is_err(),
+            "UNEXPECTED: MemoryFinalize value forge ACCEPTED — the Global memory argument did \
+             NOT pin the finalized value (would be a soundness break)"
+        );
+        println!(
+            "BUG(2) BLOCKED: MemoryFinalize value forge REJECTED. The sort-uniqueness gadget is \
+             genuinely weak (admits prev_addr==addr), but the finalized (addr,value,ts) tuple is \
+             pinned by the Global memory LogUp/septic digest, so a value/reorder forge unbalances \
+             that argument. Blocker = Global memory argument, not the sort bit."
+        );
+    }
+}
