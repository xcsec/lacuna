+    /// Byte-mult trace row index for a byte lookup event (mirror byte/traces.rs).
+    fn byte_row_index(e: &crate::chips::chips::byte::event::ByteLookupEvent) -> usize {
+        use crate::compiler::riscv::opcode::ByteOpcode;
+        if e.opcode == ByteOpcode::BitRange && e.a2 == 16 {
+            ((e.b as usize) << 8) + e.c as usize
+        } else if e.opcode == ByteOpcode::BitRange && e.a2 < 16 {
+            let base = 1usize << 16;
+            base + ((e.b as usize) << 8) + e.c as usize + (1usize << e.a2 as usize)
+        } else {
+            ((e.b as usize) << 8) + e.c as usize
+        }
+    }
+
+    /// Reporter-guided LOCAL repair of the DivRem row to the boundary
+    /// decomposition (quotient 4->3, remainder 0->2) for the 8/2 event, plus a
+    /// Byte-multiplicity rebalance of exactly the U16-range lookups the changed
+    /// limbs move. `cols.a` (the forged committed quotient, set to 3 by the
+    /// executor) is left forged.
+    fn repair_divrem_boundary(traces: &mut Vec<(String, RowMajorMatrix<F>)>) {
+        use crate::{
+            chips::{
+                chips::{
+                    alu::divrem::columns::{DivRemCols, NUM_DIVREM_COLS},
+                    byte::{
+                        columns::NUM_BYTE_MULT_COLS,
+                        event::{ByteLookupEvent, ByteRecordBehavior},
+                    },
+                },
+                gadgets::{lt_word_u16::LtWordU16Gadget, mul::MulGadget},
+            },
+            compiler::word::Word,
+            primitives::consts::LONG_WORD_SIZE,
+        };
+        use p3_field::PrimeField32;
+        use p3_matrix::Matrix;
+
+        let Some(di) = traces.iter().position(|(n, _)| n == "DivRem") else {
+            return;
+        };
+
+        let mut forged_bytes: Vec<ByteLookupEvent> = vec![];
+        let mut matched = false;
+        {
+            let trace = &mut traces[di].1;
+            let height = trace.height();
+            for row in 0..height {
+                let base = row * NUM_DIVREM_COLS;
+                let slice = &mut trace.values[base..base + NUM_DIVREM_COLS];
+                let cols: &mut DivRemCols<F> = slice.borrow_mut();
+                let v = &mut cols.values[0];
+                let is_divu = v.is_divu == F::ONE;
+                let b0 = v.b[0].as_canonical_u32();
+                let c0 = v.c[0].as_canonical_u32();
+                if !(is_divu && v.is_real == F::ONE && b0 == 8 && c0 == 2) {
+                    continue;
+                }
+                matched = true;
+                // --- rewrite forged columns (boundary decomposition q=3, r=2) ---
+                v.a = Word::from(3u64);
+                v.quotient = Word::from(3u64);
+                v.quotient_comp = Word::from(3u64);
+                v.remainder = Word::from(2u64);
+                v.remainder_comp = Word::from(2u64);
+                v.abs_remainder = Word::from(2u64);
+                for i in 0..LONG_WORD_SIZE {
+                    v.c_times_quotient[i] = F::ZERO;
+                    v.carry[i] = F::ZERO;
+                }
+                v.c_times_quotient[0] = F::from_canonical_u16(6); // c*quotient = 2*3
+                                                                  // Repopulate the two MUL gadgets EXACTLY as divrem/traces.rs does
+                                                                  // for the unsigned-64-bit path, with forged quotient_comp=3.
+                v.c_times_quotient_lower
+                    .populate(&mut forged_bytes, 3, 2, false, false, false);
+                v.c_times_quotient_upper
+                    .populate(&mut forged_bytes, 3, 2, false, false, false);
+                // abs_remainder(2) == max_abs_c_or_1(2): the EQUAL case -> all
+                // flags 0, bit 0 (the loose-bound admission).
+                v.remainder_lt_gadget = LtWordU16Gadget::default();
+                // Byte events for the differing limbs (mirror traces.rs order).
+                forged_bytes.add_u16_range_checks_field(&v.abs_remainder.0);
+                forged_bytes.add_u16_range_check(0); // lt diff (equal)
+                forged_bytes.add_u16_range_checks(&[3u16, 0, 0, 0]); // quotient
+                forged_bytes.add_u16_range_checks(&[2u16, 0, 0, 0]); // remainder
+                forged_bytes.add_u16_range_checks(&[6u16, 0, 0, 0, 0, 0, 0, 0]); // c*quotient
+                break;
+            }
+        }
+        if !matched {
+            return;
+        }
+
+        // Honest byte events for the SAME call sequence with honest values.
+        let mut honest_bytes: Vec<ByteLookupEvent> = vec![];
+        {
+            let mut hl = MulGadget::<F>::default();
+            let mut hu = MulGadget::<F>::default();
+            hl.populate(&mut honest_bytes, 4, 2, false, false, false);
+            hu.populate(&mut honest_bytes, 4, 2, false, false, false);
+            honest_bytes.add_u16_range_checks_field(&Word::<F>::from(0u64).0);
+            honest_bytes.add_u16_range_check(65534); // honest lt diff (0<2)
+            honest_bytes.add_u16_range_checks(&[4u16, 0, 0, 0]);
+            honest_bytes.add_u16_range_checks(&[0u16, 0, 0, 0]);
+            honest_bytes.add_u16_range_checks(&[8u16, 0, 0, 0, 0, 0, 0, 0]);
+        }
+
+        // delta = forged - honest (per byte-lookup key).
+        let mut delta: std::collections::HashMap<ByteLookupEvent, i64> = Default::default();
+        for e in &forged_bytes {
+            *delta.entry(*e).or_insert(0) += 1;
+        }
+        for e in &honest_bytes {
+            *delta.entry(*e).or_insert(0) -= 1;
+        }
+
+        // Rebalance the Byte provider multiplicities by exactly that delta.
+        let Some(bi) = traces.iter().position(|(n, _)| n == "Byte") else {
+            return;
+        };
+        let bt = &mut traces[bi].1;
+        let mut applied = 0usize;
+        for (e, d) in delta {
+            if d == 0 {
+                continue;
+            }
+            let row = byte_row_index(&e);
+            let col = e.opcode as usize;
+            let idx = row * NUM_BYTE_MULT_COLS + col;
+            let cur = bt.values[idx];
+            bt.values[idx] = if d >= 0 {
+                cur + F::from_canonical_u64(d as u64)
+            } else {
+                cur - F::from_canonical_u64((-d) as u64)
+            };
+            applied += 1;
+        }
+        eprintln!("DIVREM-REPAIR: forged row to (q=3,r=2); rebalanced {applied} Byte key(s).");
+    }
+
+    #[test]
+    #[ignore = "BUG(1): full-machine DivRem loose-bound boundary forge; run in --release"]
