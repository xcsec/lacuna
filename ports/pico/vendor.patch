+        chips: &[crate::machine::chip::MetaChip<F, C>],
+        traces: &[(String, RowMajorMatrix<F>)],
+    ) -> std::collections::BTreeMap<crate::machine::debug::lookups::DebugLookupKey<F>, F> {
+        use crate::machine::{
+            chip::ChipBehavior, debug::lookups::DebugLookupKey, lookup::LookupScope,
+        };
+        use p3_matrix::Matrix;
+        use std::iter::repeat;
+        let mut acc: std::collections::BTreeMap<DebugLookupKey<F>, F> =
+            std::collections::BTreeMap::new();
+        let empty: [F; 0] = [];
+        for chip in chips {
+            let name = chip.name();
+            let Some((_, trace)) = traces.iter().find(|(n, _)| *n == name) else {
+                continue;
+            };
+            let height = trace.height();
+            if height == 0 {
+                continue;
+            }
+            let prep = pk
+                .preprocessed_chip_ordering
+                .get(&name)
+                .map(|&n| &pk.preprocessed_trace[n]);
+            let looking = chip
+                .looking
+                .iter()
+                .filter(|l| l.scope == LookupScope::Regional)
+                .zip(repeat(true));
+            let looked = chip
+                .looked
+                .iter()
+                .filter(|l| l.scope == LookupScope::Regional)
+                .zip(repeat(false));
+            let lookups: Vec<_> = looking.chain(looked).collect();
+            for row in 0..height {
+                let main_row = trace.row_slice(row);
+                let prep_row_slice = prep.map(|t| t.row_slice(row));
+                let prep_row = prep_row_slice.as_deref().unwrap_or(empty.as_slice());
+                for (lookup, is_looking) in &lookups {
+                    let mult: F = lookup.mult.apply(prep_row, &main_row);
+                    let values: Box<[F]> = lookup
+                        .values
+                        .iter()
+                        .map(|v| v.apply(prep_row, &main_row))
+                        .collect();
+                    let key = DebugLookupKey {
+                        kind: lookup.kind,
+                        values,
+                    };
+                    let e = acc.entry(key).or_insert(F::ZERO);
+                    if *is_looking {
+                        *e += mult;
+                    } else {
+                        *e -= mult;
+                    }
+                }
+            }
+        }
+        acc
+    }
