+// ============================================================================
+// END-TO-END (LOOKUPS ON) — full production machine, all cross-chip buses live.
+//
+// The c1_* tests above run the LT chip in isolation with MetaChip::test_no_lookup
+// (buses OFF) — that proves the per-chip AIR gap (a[0] free). These e2e_* tests
+// use RiscvChipType::all_chips() (MetaChip::new, buses ON) which INCLUDES the Cpu
+// chip, so the ALU looking/looked lookup bus and the register/memory bus are
+// actually enforced. If a forge survives HERE, it is a full-machine soundness
+// break, not a per-chip artifact.
+// ============================================================================
+
+mod e2e_full_machine {
+    //! Full production machine (RiscvChipType::all_chips(), MetaChip::new =
+    //! lookups ON), driven through the GENUINE `RiscvMachine::prove_with_shape_
+    //! report` + `RiscvMachine::verify` — the exact production STARK pipeline
+    //! (real challenger, regional+global cumulative-sum balancing, public
+    //! values). A forge is injected via the test-only `forge_hook` consulted
+    //! inside the real prove between generate_main and commit_main. This is the
+    //! same plumbing as `precompiles/precompile_lookup_forge.rs`, applied to the
+    //! base-ISA SLT chip.
+    use crate::{
+        chips::chips::alu::lt::columns::{LtCols, NUM_LT_COLS},
+        compiler::riscv::{
+            compiler::{Compiler, SourceType},
+            instruction::Instruction,
+            opcode::Opcode,
+            program::Program,
+        },
+        configs::stark_config::KoalaBearPoseidon2,
+        emulator::{opts::EmulatorOpts, stdin::EmulatorStdin},
+        instances::{
+            chiptype::riscv_chiptype::RiscvChipType,
+            machine::riscv::{forge_hook, RiscvMachine},
+        },
+        machine::{
+            keys::{BaseProvingKey, BaseVerifyingKey},
+            machine::MachineBehavior,
+            proof::MetaProof,
+            witness::ProvingWitness,
+        },
+        primitives::consts::RISCV_NUM_PVS,
+    };
+    use core::borrow::BorrowMut;
+    use p3_field::FieldAlgebra;
+    use p3_koala_bear::KoalaBear;
+    use p3_matrix::dense::RowMajorMatrix;
+    use std::sync::Arc;
+
+    type F = KoalaBear;
+    type SC = KoalaBearPoseidon2;
+    type C = RiscvChipType<KoalaBear>;
+
+    /// SLT program that HALTS CLEANLY (mirrors precompiles::precompile_lookup_forge
+    /// ::trivial_program_real_pipeline). The full pipeline enforces the halt /
+    /// public-value / continuity constraints, so the ECALL must be a real HALT:
+    /// x5 = 0 (syscall reg = HALT), x10 = 0 (exit code), then ECALL.
+    ///   x10 = 10; x11 = 3; SLT x12 = (10 < 3) = 0  ← the instruction under test.
+    fn slt_program_halting() -> Program {
+        let instructions = vec![
+            Instruction::new(Opcode::ADD, 10, 0, 10, false, true),
+            Instruction::new(Opcode::ADD, 11, 0, 3, false, true),
+            Instruction::new(Opcode::SLT, 12, 10, 11, false, false), // honest x12 = 0
+            Instruction::new(Opcode::ADD, 5, 0, 0, false, true),     // clean HALT
+            Instruction::new(Opcode::ADD, 10, 0, 0, false, true),
+            Instruction::new(Opcode::ECALL, 0, 0, 0, false, false),
+        ];
+        Program::new(instructions, 0x1_0000, 0x1_0000)
+    }
+
+    fn build() -> (
+        RiscvMachine<SC, C>,
+        BaseProvingKey<SC>,
+        BaseVerifyingKey<SC>,
+        Arc<Program>,
+    ) {
+        let program = Arc::new(slt_program_halting());
+        let config = SC::test();
+        let machine = RiscvMachine::new(config, RiscvChipType::all_chips(), RISCV_NUM_PVS);
+        let (pk, vk) = machine.setup_keys(&program);
+        (machine, pk, vk, program)
+    }
+
+    /// Run the REAL pipeline with `hook` applied to the full main-trace list
+    /// (chip-name -> matrix) between generate_main and commit_main. Panics
+    /// (bus/constraint failure) are caught and surfaced as Err.
+    fn run(
+        machine: &RiscvMachine<SC, C>,
+        pk: &BaseProvingKey<SC>,
+        vk: &BaseVerifyingKey<SC>,
+        program: &Arc<Program>,
+        hook: impl FnMut(&mut Vec<(String, RowMajorMatrix<F>)>) + Send + 'static,
+    ) -> Result<(), String> {
+        let stdin = EmulatorStdin::<Program, Vec<u8>>::new_builder::<SC>()
+            .finalize()
+            .0;
+        let boxed: Box<dyn FnMut(&mut Vec<(String, RowMajorMatrix<F>)>) + Send> = Box::new(hook);
+        let prev = std::panic::take_hook();
+        if std::env::var("FORGE_DEBUG").is_err() {
+            std::panic::set_hook(Box::new(|_| {}));
+        }
+        let res = std::panic::catch_unwind(std::panic::AssertUnwindSafe(|| {
+            forge_hook::with_hook(boxed, || {
+                let witness = ProvingWitness::<SC, C, Vec<u8>>::setup_for_riscv(
+                    program.clone(),
+                    stdin,
+                    EmulatorOpts::default(),
+                    pk.clone(),
+                    vk.clone(),
+                );
+                let (proof, _reports): (MetaProof<SC>, _) =
+                    machine.prove_with_shape_report(&witness, None);
+                machine.verify(&proof, vk).map_err(|e| format!("{e:?}"))
+            })
+        }));
+        std::panic::set_hook(prev);
+        match res {
+            Ok(inner) => inner,
+            Err(_) => Err("panic (bus/constraint failure)".to_string()),
+        }
+    }
+
+    /// Set limb `idx` of the SLT result word `a` in physical row `row` of the
+    /// LessThan chip main trace to `val`.
+    fn set_lt_a(trace: &mut RowMajorMatrix<F>, row: usize, idx: usize, val: u32) {
+        let base = row * NUM_LT_COLS;
+        let slice = &mut trace.values[base..base + NUM_LT_COLS];
+        let cols: &mut LtCols<F> = slice.borrow_mut();
+        cols.values[0].a[idx] = F::from_canonical_u32(val);
+    }
+
+    #[test]
+    #[ignore = "WIP: hand-built programs do not close pico's regional memory argument (see e2e_diag_regional_lookups); needs a real guest ELF baseline"]
+    fn e2e_gate_honest_slt_verifies() {
+        // Sanity gate: the HONEST SLT program must prove+verify with lookups ON
+        // through the genuine RiscvMachine pipeline. If this fails, nothing below
+        // is trustworthy.
+        let (machine, pk, vk, program) = build();
+        let res = run(&machine, &pk, &vk, &program, |_| {});
+        println!("E2E honest gate: {res:?}");
+        assert!(
+            res.is_ok(),
+            "E2E HONEST GATE FAILED (driver invalid): {res:?}"
+        );
+        println!("E2E GATE OK: honest SLT proves+verifies with all lookups ON.");
+    }
+
+    /// Real compiled fib ELF (does loop comparisons → SLT/branch). Real ELFs close
+    /// the regional memory argument that hand-built programs do not.
+    fn fib_elf_program() -> Arc<Program> {
+        let elf: &[u8] =
+            include_bytes!("../../../../compiler/test_elf/riscv64im-pico-fibnacci-elf");
+        Compiler::new(SourceType::RISCV, elf)
+            .expect("parse fib elf")
+            .compile()
+    }
+
+    /// Custom guest ELF: reads a,b:u32, commits `c = (a<b) as u32` (4-byte LE).
+    /// The user `<` lowered to exactly ONE `sltu a0,a0,a1` @0x200c44, and c IS the
+    /// committed public output — the ideal SLT forge target.
+    const LTGUEST_ELF_PATH: &str =
+        "<LACUNA_GUEST_ELF_DIR>/riscv64im-pico-zkvm-elf";
+
+    fn ltguest_program() -> Arc<Program> {
+        let elf = std::fs::read(LTGUEST_ELF_PATH).expect("read ltguest elf");
+        Compiler::new(SourceType::RISCV, &elf)
+            .expect("parse ltguest elf")
+            .compile()
+    }
+
+    fn ltguest_stdin() -> EmulatorStdin<Program, Vec<u8>> {
+        // a=5, b=3  ->  honest c = (5<3) = 0
+        let mut b = EmulatorStdin::<Program, Vec<u8>>::new_builder::<SC>();
+        b.write(&5u32);
+        b.write(&3u32);
+        b.finalize().0
+    }
+
+    // ───────────────────────── P-CLK (free data-mem timestamp) ─────────────────────────
+    // Guest does: sd V1->A ; sd V2->A ; ld A ; commit(loaded).  Honest ld returns V2.
+    // The CPU->mem "Memory" lookup carries NO clk, so the mem chip's (chunk,clk) is a
+    // FREE witness. The forge reorders the ld's clk to sit between the two stores so the
+    // offline-memory argument makes it read V1 (a stale value) and commits it.
+    const PCLK_ELF_PATH: &str =
+        "<LACUNA_GUEST_ELF_DIR>/pclkguest/elf/riscv64im-pico-zkvm-elf";
+    #[allow(dead_code)]
+    const PCLK_V1: u64 = 0x1111_1111_1111_1111;
+    const PCLK_V2: u64 = 0x2222_2222_2222_2222;
+
+    fn pclk_program() -> Arc<Program> {
+        let elf = std::fs::read(PCLK_ELF_PATH).expect("read pclk elf");
+        Compiler::new(SourceType::RISCV, &elf)
+            .expect("parse pclk elf")
+            .compile()
+    }
+
+    fn pclk_stdin() -> EmulatorStdin<Program, Vec<u8>> {
+        EmulatorStdin::<Program, Vec<u8>>::new_builder::<SC>()
+            .finalize()
+            .0
+    }
+
+    #[test]
+    #[ignore = "P-CLK baseline: honest sd V1; sd V2; ld A must commit V2=0x2222.. and VERIFY"]
+    fn e2e_pclk_honest_baseline() {
+        crate::machine::logger::setup_logger();
+        let program = pclk_program();
+        let machine = RiscvMachine::new(SC::test(), RiscvChipType::all_chips(), RISCV_NUM_PVS);
+        let (pk, vk) = machine.setup_keys(&program);
+        let witness = ProvingWitness::<SC, C, Vec<u8>>::setup_for_riscv(
+            program.clone(),
+            pclk_stdin(),
+            EmulatorOpts::default(),
+            pk.clone(),
+            vk.clone(),
+        );
+        let (proof, _r) = machine.prove_with_shape_report(&witness, None);
+        let pv = proof.pv_stream.clone();
+        let res = machine.verify(&proof, &vk).map_err(|e| format!("{e:?}"));
+        println!("P-CLK HONEST pv={pv:x?}  verify={res:?}");
+        assert_eq!(
+            pv.as_deref(),
+            Some(&PCLK_V2.to_le_bytes()[..]),
+            "honest load must commit V2=0x2222.."
+        );
+        assert!(res.is_ok(), "honest P-CLK program must verify: {res:?}");
+        println!("P-CLK BASELINE OK: honest ld=V2 verifies (=> guest + driver sound).");
+    }
+
+    fn pclk_word_u64(w: &crate::compiler::word::Word<F>) -> u64 {
+        use p3_field::PrimeField32;
+        (w.0[0].as_canonical_u32() as u64)
+            | ((w.0[1].as_canonical_u32() as u64) << 16)
+            | ((w.0[2].as_canonical_u32() as u64) << 32)
+            | ((w.0[3].as_canonical_u32() as u64) << 48)
+    }
+
+    /// Diagnostic hook: dump the A-address (V1/V2) MemoryReadWrite rows (S1, S2, L) with
+    /// their timestamp columns, so the reorder is written from real data (clk convention,
+    /// diff encoding). Runs on the value-forged trace (executor rd=V1 + trace-gen value arm).
+    #[allow(dead_code)]
+    fn pclk_dump_hook(traces: &mut Vec<(String, RowMajorMatrix<F>)>) {
+        use crate::chips::chips::riscv_memory::read_write::columns::{
+            MemoryChipValueCols, NUM_MEMORY_CHIP_VALUE_COLS,
+        };
+        use core::borrow::Borrow;
+        use p3_field::PrimeField32;
+        use p3_matrix::Matrix;
+        let Some(mi) = traces.iter().position(|(n, _)| n == "MemoryReadWrite") else {
+            eprintln!("PCLK-DUMP: no MemoryReadWrite trace");
+            return;
+        };
+        let trace = &traces[mi].1;
+        let ncols = trace.width();
+        let per = NUM_MEMORY_CHIP_VALUE_COLS;
+        let nblocks = trace.values.len() / per;
+        eprintln!(
+            "=== PCLK mem rows (A-address V1/V2); ncols={ncols} per={per} blocks={nblocks} ==="
+        );
+        for b in 0..nblocks {
+            let base = b * per;
+            let cols: &MemoryChipValueCols<F> = trace.values[base..base + per].borrow();
+            let val = pclk_word_u64(&cols.memory_access.access.value);
+            let is_ld = cols.instruction.is_ld == F::ONE;
+            let is_sd = cols.instruction.is_sd == F::ONE;
+            if (is_ld || is_sd) && (val == PCLK_V1 || val == PCLK_V2) {
+                eprintln!(
+                    "blk{b} {} addr={:#x} val={:#018x} pv={:#018x} chunk={} clk={} pchunk={} pclk={} cmp={} d16={} d8={}",
+                    if is_ld { "LD" } else { "SD" },
+                    pclk_word_u64(&cols.addr_word),
+                    val,
+                    pclk_word_u64(&cols.memory_access.prev_value),
+                    cols.chunk.as_canonical_u32(),
+                    cols.clk.as_canonical_u32(),
+                    cols.memory_access.access.prev_chunk.as_canonical_u32(),
+                    cols.memory_access.access.prev_clk.as_canonical_u32(),
+                    cols.memory_access.access.compare_clk.as_canonical_u32(),
+                    cols.memory_access.access.diff_16bit_limb.as_canonical_u32(),
+                    cols.memory_access.access.diff_8bit_limb.as_canonical_u32(),
+                );
+            }
