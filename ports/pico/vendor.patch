+    #[test]
+    #[ignore = "diagnostic N4: prints the PRECISE residual regional-lookup key(s) the DIVUW forge+hook leaves"]
+    fn e2e_divuw_diag_residual() {
+        use p3_field::Field;
+        crate::machine::logger::setup_logger();
+        let program = divuw_program();
+        let machine = RiscvMachine::new(SC::test(), RiscvChipType::all_chips(), RISCV_NUM_PVS);
+        let (pk, vk) = machine.setup_keys(&program);
+
+        // FAITHFUL: compute the regional balance INSIDE the real forge_hook, on the
+        // exact per-chunk trace list the prover COMMITS (post complement_record +
+        // generate_main). bal_before = pre-mutation (honest-forged-record) balance;
+        // bal_after = post-N4-hook. The verifier's `regional_cumulative_sum` equals
+        // the per-key (looking − looked) multiset sum, so the nonzero keys of
+        // bal_after (and of the diff) are EXACTLY what the verifier rejects.
+        let pk_arc = std::sync::Arc::new(pk.clone());
+        let chips_arc = std::sync::Arc::new(RiscvChipType::<KoalaBear>::all_chips());
+        let hook: forge_hook::Hook = {
+            let pk = pk_arc.clone();
+            let chips = chips_arc.clone();
+            Box::new(move |traces: &mut Vec<(String, RowMajorMatrix<F>)>| {
+                let has_dr = traces.iter().any(|(n, _)| n == "DivRem");
+                if !has_dr {
+                    divuw_forge_hook(traces);
+                    return;
+                }
+                let bal_before = regional_balance_from_mut_traces(&pk, &chips, traces.as_slice());
+                divuw_forge_hook(traces);
+                let bal_after = regional_balance_from_mut_traces(&pk, &chips, traces.as_slice());
+                let nz_before = bal_before.values().filter(|v| !v.is_zero()).count();
+                let nz_after = bal_after.values().filter(|v| !v.is_zero()).count();
+                eprintln!("[HOOK] DivRem chunk: nz_before={nz_before} nz_after={nz_after}");
+                // Absolute residual the verifier sees (nonzero bal_after keys).
+                let mut abs_res = 0usize;
+                for (k, v) in &bal_after {
+                    if !v.is_zero() {
+                        abs_res += 1;
+                        if abs_res <= 40 {
+                            eprintln!("[HOOK] ABS-RESIDUAL {:+} for {}", to_signed_kb(*v), k);
+                        }
+                    }
+                }
+                eprintln!("[HOOK] total ABS residual keys = {abs_res}");
+                // Diff (after − before) isolates exactly what the hook changed.
+                let mut keys: std::collections::BTreeSet<_> = bal_before.keys().cloned().collect();
+                keys.extend(bal_after.keys().cloned());
+                for k in &keys {
+                    let a = bal_before.get(k).copied().unwrap_or(F::ZERO);
+                    let b = bal_after.get(k).copied().unwrap_or(F::ZERO);
+                    let d = b - a;
+                    if !d.is_zero() {
+                        eprintln!("[HOOK] HOOK-DIFF {:+} for {}", to_signed_kb(d), k);
+                    }
+                }
+            })
+        };
+
+        // ---- HONEST baseline: NO executor forge, hook only measures balance ----
+        let honest_hook: forge_hook::Hook = {
+            let pk = pk_arc.clone();
+            let chips = chips_arc.clone();
+            Box::new(move |traces: &mut Vec<(String, RowMajorMatrix<F>)>| {
+                if !traces.iter().any(|(n, _)| n == "DivRem") {
+                    return;
+                }
+                let bal = regional_balance_from_mut_traces(&pk, &chips, traces.as_slice());
+                let mut nz = 0usize;
+                for (k, v) in &bal {
+                    if !v.is_zero() {
+                        nz += 1;
+                        eprintln!("[HONEST-HOOK] IMBALANCE {:+} for {}", to_signed_kb(*v), k);
+                    }
+                }
+                eprintln!("[HONEST-HOOK] DivRem chunk nonzero regional keys = {nz}");
+            })
+        };
+        let honest_res = forge_hook::with_hook(honest_hook, || {
+            let witness = ProvingWitness::<SC, C, Vec<u8>>::setup_for_riscv(
+                program.clone(),
+                divuw_stdin(),
+                EmulatorOpts::default(),
+                pk.clone(),
+                vk.clone(),
+            );
+            let (proof, _r) = machine.prove_with_shape_report(&witness, None);
+            let pv = proof.pv_stream.clone();
+            let res: Result<(), String> =
+                match std::panic::catch_unwind(std::panic::AssertUnwindSafe(|| {
+                    machine.verify(&proof, &vk)
+                })) {
+                    Ok(inner) => inner.map_err(|e| format!("{e:?}")),
+                    Err(_) => Err("verify panicked".to_string()),
+                };
+            (pv, res)
+        });
+        println!(
+            "HONEST DIVUW pv={:x?} verify={:?}",
+            honest_res.0, honest_res.1
+        );
+
+        // ---- FORGED: executor forge + N4 hook ----
+        let (pv, res) = crate::emulator::riscv::emulator::sltu_forge::with_forge(|| {
+            forge_hook::with_hook(hook, || {
+                let witness = ProvingWitness::<SC, C, Vec<u8>>::setup_for_riscv(
+                    program.clone(),
+                    divuw_stdin(),
+                    EmulatorOpts::default(),
+                    pk.clone(),
+                    vk.clone(),
+                );
+                let (proof, _r) = machine.prove_with_shape_report(&witness, None);
+                let pv = proof.pv_stream.clone();
+                let res: Result<(), String> =
+                    match std::panic::catch_unwind(std::panic::AssertUnwindSafe(|| {
+                        machine.verify(&proof, &vk)
+                    })) {
+                        Ok(inner) => inner.map_err(|e| format!("{e:?}")),
+                        Err(_) => Err("verify panicked".to_string()),
+                    };
+                (pv, res)
+            })
+        });
+        println!("DIAG pv={pv:x?} verify={res:?}");
+        println!(
+            "DIAG DONE: [HOOK]/[HONEST-HOOK] lines above pinpoint the residual regional key(s)."
+        );
+    }
