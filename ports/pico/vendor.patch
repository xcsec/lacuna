+    /// P-CLK timestamp-reorder hook. The executor+trace-gen arms already forged the target
+    /// load's committed value to V1; here we reorder its FREE mem-access clk to sit between the
+    /// two stores S1(V1),S2(V2) and re-chain: L.prev->S1, S2.prev->L, S3.prev->S2 (S3 keeps A's
+    /// last-access slot so the MemoryFinalize pin is unchanged). Convention (from e2e_pclk_dump):
+    /// prev_clk = prev access's clk; diff = (clk - prev_clk) - 1; compare_clk=1 same chunk.
+    fn forge_pclk_reorder(traces: &mut Vec<(String, RowMajorMatrix<F>)>) {
+        use crate::chips::chips::riscv_memory::read_write::columns::{
+            MemoryChipValueCols, NUM_MEMORY_CHIP_VALUE_COLS,
+        };
+        use core::borrow::{Borrow, BorrowMut};
+        use p3_field::PrimeField32;
+        const V3: u64 = 0x3333_3333_3333_3333;
+        let Some(mi) = traces.iter().position(|(n, _)| n == "MemoryReadWrite") else {
+            return;
+        };
+        let trace = &mut traces[mi].1;
+        let per = NUM_MEMORY_CHIP_VALUE_COLS;
+        let nblocks = trace.values.len() / per;
+        let read_blk = |values: &[F], b: usize| -> (bool, bool, u64, u64, u32, u32) {
+            let base = b * per;
+            let cols: &MemoryChipValueCols<F> = values[base..base + per].borrow();
+            (
+                cols.instruction.is_ld == F::ONE,
+                cols.instruction.is_sd == F::ONE,
+                pclk_word_u64(&cols.addr_word),
+                pclk_word_u64(&cols.memory_access.access.value),
+                cols.clk.as_canonical_u32(),
+                cols.chunk.as_canonical_u32(),
+            )
+        };
+        let mut a = None;
+        let (mut lb, mut s1b, mut s2b, mut s3b) = (None, None, None, None);
+        for b in 0..nblocks {
+            let (is_ld, _, addr, val, _, _) = read_blk(&trace.values, b);
+            if is_ld && val == PCLK_V1 {
+                a = Some(addr);
+                lb = Some(b);
+                break;
+            }
+        }
+        let Some(a) = a else {
+            return;
+        };
+        for b in 0..nblocks {
+            let (_, is_sd, addr, val, _, _) = read_blk(&trace.values, b);
+            if is_sd && addr == a {
+                match val {
+                    PCLK_V1 => s1b = Some(b),
+                    PCLK_V2 => s2b = Some(b),
+                    V3 => s3b = Some(b),
+                    _ => {}
+                }
+            }
+        }
+        let (Some(l), Some(s1), Some(s2), Some(s3)) = (lb, s1b, s2b, s3b) else {
+            eprintln!(
+                "PCLK-REORDER: missing rows A={a:#x} l={lb:?} s1={s1b:?} s2={s2b:?} s3={s3b:?}"
+            );
+            return;
+        };
+        let (.., s1_clk, chunk) = read_blk(&trace.values, s1);
+        let (.., s2_clk, _) = read_blk(&trace.values, s2);
+        let (.., s3_clk, _) = read_blk(&trace.values, s3);
+        let (.., l_clk, _) = read_blk(&trace.values, l);
+        let set_ts = |values: &mut [F], b: usize, clk: u32, prev_clk: u32| {
+            let base = b * per;
+            let cols: &mut MemoryChipValueCols<F> = values[base..base + per].borrow_mut();
+            cols.clk = F::from_canonical_u32(clk);
+            cols.memory_access.access.prev_clk = F::from_canonical_u32(prev_clk);
+            cols.memory_access.access.prev_chunk = F::from_canonical_u32(chunk);
+            cols.memory_access.access.compare_clk = F::ONE;
+            let diff = clk - prev_clk - 1;
+            cols.memory_access.access.diff_16bit_limb = F::from_canonical_u32(diff & 0xFFFF);
+            cols.memory_access.access.diff_8bit_limb = F::from_canonical_u32((diff >> 16) & 0xFF);
+        };
+        // Swap L and S2's FREE mem-access clk (L takes S2's slot, S2 takes L's), so the reordered
+        // chain S1->L->S2->S3 keeps the SAME diff multiset {3,3,3} as honest S1->S2->L->S3 => no
+        // range-check (diff) multiplicity rebalance needed. L now chains off S1 -> reads stale V1.
+        set_ts(&mut trace.values, l, s2_clk, s1_clk); // L: clk=S2's old slot, prev=S1
+        set_ts(&mut trace.values, s2, l_clk, s2_clk); // S2: clk=L's old slot, prev=L(@s2_clk)
+        set_ts(&mut trace.values, s3, s3_clk, l_clk); // S3: prev=S2(@l_clk)
+        eprintln!("PCLK-REORDER A={a:#x}: swap L({l_clk})<->S2({s2_clk}); s1={s1_clk} s3={s3_clk}");
+    }
+
+    fn pclk_run(reorder: bool) -> (Option<Vec<u8>>, Result<(), String>) {
+        let program = pclk_program();
+        let machine = RiscvMachine::new(SC::test(), RiscvChipType::all_chips(), RISCV_NUM_PVS);
+        let (pk, vk) = machine.setup_keys(&program);
+        let hook: forge_hook::Hook = if reorder {
+            Box::new(forge_pclk_reorder)
+        } else {
+            Box::new(|_traces: &mut Vec<(String, RowMajorMatrix<F>)>| {})
+        };
+        crate::emulator::riscv::emulator::pclk_forge::with_forge(|| {
+            forge_hook::with_hook(hook, || {
+                let witness = ProvingWitness::<SC, C, Vec<u8>>::setup_for_riscv(
+                    program.clone(),
+                    pclk_stdin(),
+                    EmulatorOpts::default(),
+                    pk.clone(),
+                    vk.clone(),
+                );
+                let (proof, _r) = machine.prove_with_shape_report(&witness, None);
+                let pv = proof.pv_stream.clone();
+                let prev = std::panic::take_hook();
+                std::panic::set_hook(Box::new(|_| {}));
+                let res = match std::panic::catch_unwind(std::panic::AssertUnwindSafe(|| {
+                    machine.verify(&proof, &vk)
+                })) {
+                    Ok(inner) => inner.map_err(|e| format!("{e:?}")),
+                    Err(_) => Err("panic (bus/constraint failure)".to_string()),
+                };
+                std::panic::set_hook(prev);
+                (pv, res)
+            })
+        })
+    }
