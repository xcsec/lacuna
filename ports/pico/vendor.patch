+    // ========================================================================
+    // N2 — pico ShiftRight shift-amount decoupling (`c` vs `c_for_lookup`).
+    //
+    // sr/constraints.rs derives the WHOLE shift (c_bits, bit_shift, v_*, lower/
+    // higher_limb, limb_result, and for 64-bit SRL the RESULT a) from the column
+    // `c` (L67-88), but `c` is NEVER assert_eq'd to `c_for_lookup` — the operand
+    // actually sent/received on the ALU bus (looked_alu L198-207). So a malicious
+    // prover can make the SR chip shift by a DIFFERENT amount than rs2: it sets
+    // c_for_lookup = the true rs2 (so the CPU<->ALU bus balances) while c = a
+    // different shift (so the committed result is b >> c, not b >> rs2).
+    //
+    // Vehicle: 64-bit SRL (result IS forced by the shift decomposition; for SRLW
+    // the low limbs are separately unconstrained, a weaker demonstration).
+    // Guest `srl a2,a0,a1` with a0=0xFF00 (value=b), a1=4 (shift=rs2). Honest
+    // 0xFF00>>4 = 0xFF0. Forge shift 4→8 → committed q = 0xFF00>>8 = 0xFF.
+    // ========================================================================
+    const SRL_N2_ELF_PATH: &str =
+        "<LACUNA_GUEST_ELF_DIR>/srlguest/elf/riscv64im-pico-zkvm-elf";
+
+    #[test]
+    #[ignore = "N2 VALIDITY: does HONEST SRL verify (clean-gold check, no forge/hook)?"]
+    fn e2e_srl_shiftamt_honest_baseline() {
+        crate::machine::logger::setup_logger();
+        let elf = std::fs::read(SRL_N2_ELF_PATH).expect("read srl n2 elf");
+        let program = Compiler::new(SourceType::RISCV, &elf)
+            .expect("parse srl elf")
+            .compile();
+        let machine = RiscvMachine::new(SC::test(), RiscvChipType::all_chips(), RISCV_NUM_PVS);
+        let (pk, vk) = machine.setup_keys(&program);
+        let mut sb = EmulatorStdin::<Program, Vec<u8>>::new_builder::<SC>();
+        sb.write(&0xFF00u64);
+        sb.write(&4u64);
+        let (stdin, _) = sb.finalize();
+        let witness = ProvingWitness::<SC, C, Vec<u8>>::setup_for_riscv(
+            program.clone(),
+            stdin,
+            EmulatorOpts::default(),
+            pk,
+            vk.clone(),
+        );
+        let (proof, _r) = machine.prove_with_shape_report(&witness, None);
+        let pv = proof.pv_stream.clone();
+        let res =
+            std::panic::catch_unwind(std::panic::AssertUnwindSafe(|| machine.verify(&proof, &vk)));
+        let ok = matches!(res, Ok(Ok(())));
+        println!("HONEST SRL(0xFF00,4) pv={pv:x?}  verify_ok={ok}");
+        assert_eq!(
+            pv.as_deref(),
+            Some(&0xFF0u64.to_le_bytes()[..]),
+            "honest 0xFF00>>4 = 0xFF0"
+        );
+        assert!(
+            ok,
+            "honest SRL must VERIFY — else N2 gold is confounded like N4 (DIVUW)"
+        );
+        println!(
+            "N2 CLEAN: honest SRL=0xFF0 verifies; forge commits 0xFF and verifies => clean gold."
+        );
+    }
+
+    fn srl_n2_program() -> Arc<Program> {
+        let elf = std::fs::read(SRL_N2_ELF_PATH).expect("read srl n2 elf");
+        Compiler::new(SourceType::RISCV, &elf)
+            .expect("parse srl n2 elf")
+            .compile()
+    }
+
+    fn srl_n2_stdin() -> EmulatorStdin<Program, Vec<u8>> {
+        let mut b = EmulatorStdin::<Program, Vec<u8>>::new_builder::<SC>();
+        b.write(&0xFF00u64); // value being shifted (rs1 -> SR chip operand b)
+        b.write(&4u64); // shift amount (rs2 -> SR chip operand c / c_for_lookup)
+        b.finalize().0
+    }
+
+    fn srl_n2_forge_hook(traces: &mut Vec<(String, RowMajorMatrix<F>)>) {
+        srl_n2_forge_hook_inner(traces, true);
+    }
+
+    /// N2 forge_hook. Rewrite the ShiftRight SRL(0xFF00,4) row to compute a
+    /// SHIFT-BY-8 (c=8 + c_bits + v_* + lower/higher_limb + limb_result + a=0xFF)
+    /// while KEEPING `c_for_lookup = 4` (the true rs2 on the ALU bus). Then
+    /// rebalance the Byte BitRange provider for every decomposition byte-check the
+    /// re-shift changed. `rebalance=false` (negative control) leaves the Byte
+    /// provider matching the honest shift-4 decomposition → regional sum ≠ 0 →
+    /// verifier REJECTS.
+    fn srl_n2_forge_hook_inner(traces: &mut Vec<(String, RowMajorMatrix<F>)>, rebalance: bool) {
+        use crate::{
+            chips::chips::{
+                alu::sr::{ShiftRightCols, NUM_SLR_COLS},
+                byte::{
+                    columns::NUM_BYTE_MULT_COLS,
+                    event::{ByteLookupEvent, ByteRecordBehavior},
+                },
+            },
+            compiler::word::Word,
+        };
+        const WS: usize = 4; // WORD_SIZE (u16 limbs in a 64-bit word)
+        let b_limbs = [0xFF00u32, 0, 0, 0]; // b = 0xFF00 as u16 limbs
+
+        let mut matched = false;
+        if let Some(si) = traces.iter().position(|(n, _)| n == "ShiftRight") {
+            let mat = &mut traces[si].1;
+            let nrows = mat.values.len() / NUM_SLR_COLS;
+            for row in 0..nrows {
+                let base = row * NUM_SLR_COLS;
+                let cols: &mut ShiftRightCols<F> =
+                    mat.values[base..base + NUM_SLR_COLS].borrow_mut();
+                let v = &mut cols.values[0];
+                if v.is_srl == F::ONE
+                    && v.b.0[0] == F::from_canonical_u32(0xFF00)
+                    && v.c_for_lookup.0[0] == F::from_canonical_u32(4)
+                {
+                    // Re-shift the chip's internal shift amount c: 4 -> 8.
+                    v.c = F::from_canonical_u32(8);
+                    // c_bits = 6 low bits of 8 = 0b001000.
+                    v.c_bits = [F::ZERO, F::ZERO, F::ZERO, F::ONE, F::ZERO, F::ZERO];
+                    v.v_01 = F::from_canonical_u32(16); // 1<<(4-(8&3))
+                    v.v_012 = F::from_canonical_u32(256); // 1<<(8-(8&7))
+                    v.v_0123 = F::from_canonical_u32(256); // 1<<(16-(8&15))
+                                                           // bit_shift = 8: split each limb at bit 8.
+                    for i in 0..WS {
+                        let lower = (b_limbs[i] & ((1 << 8) - 1)) as u16;
+                        let higher = (b_limbs[i] >> 8) as u16;
+                        v.lower_limb.0[i] = F::from_canonical_u16(lower);
+                        v.higher_limb.0[i] = F::from_canonical_u16(higher);
+                    }
+                    for i in 0..WS {
+                        let mut lr = v.higher_limb.0[i];
+                        if i != WS - 1 {
+                            lr += v.lower_limb.0[i + 1] * F::from_canonical_u32(1 << (16 - 8));
+                        }
+                        v.limb_result[i] = lr;
+                    }
+                    // shift_u16 stays [1,0,0,0] (shift_amount=0 for both 4 and 8).
+                    // b_msb/srw_msb/sra_msb_v0123 stay 0 for SRL.
+                    v.sra_msb_v0123 = F::ZERO;
+                    // Committed result a = 0xFF00 >> 8 = 0xFF.
+                    v.a = Word::from(0xFFu64);
+                    // c_for_lookup is DELIBERATELY left = 4 (the true rs2).
+                    matched = true;
+                }
+            }
+        }
+        if !matched || !rebalance {
+            return;
+        }
+        // Byte BitRange rebalance: forged (shift 8) vs honest (shift 4) decomposition,
+        // mirroring sr/traces.rs `event_to_row` byte events exactly.
+        let mut forged: Vec<ByteLookupEvent> = vec![];
+        let mut honest: Vec<ByteLookupEvent> = vec![];
+        // (a) c>>6 check (L140): unchanged (both 0), included for completeness.
+        forged.add_bit_range_check(8u16 >> 6, 10);
+        honest.add_bit_range_check(4u16 >> 6, 10);
+        // (b) per-limb lower/higher BitRange checks (L190-191).
+        for &limb in &b_limbs {
+            forged.add_bit_range_check((limb & 0xFF) as u16, 8); // lower, bit_shift=8
+            forged.add_bit_range_check((limb >> 8) as u16, 16 - 8); // higher
+            honest.add_bit_range_check((limb & 0xF) as u16, 4); // lower, bit_shift=4
+            honest.add_bit_range_check((limb >> 4) as u16, 16 - 4); // higher
+        }
+        let mut delta: std::collections::HashMap<ByteLookupEvent, i64> = Default::default();
+        for e in &forged {
+            *delta.entry(*e).or_insert(0) += 1;
+        }
+        for e in &honest {
+            *delta.entry(*e).or_insert(0) -= 1;
+        }
+        if let Some(bi) = traces.iter().position(|(n, _)| n == "Byte") {
+            let bt = &mut traces[bi].1;
+            for (e, d) in delta {
+                if d == 0 {
+                    continue;
+                }
+                let idx = byte_row_index(&e) * NUM_BYTE_MULT_COLS + e.opcode as usize;
+                let cur = bt.values[idx];
+                bt.values[idx] = if d >= 0 {
+                    cur + F::from_canonical_u64(d as u64)
+                } else {
+                    cur - F::from_canonical_u64((-d) as u64)
+                };
+            }
+        }
+    }
