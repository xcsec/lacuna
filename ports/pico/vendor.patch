+/// #3 branch control-flow forge driver. The branch chip binds `a_lt_b` via an ALU-SLT lookup
+/// whose provider (the Lt chip) puts the value in its FREE `a[0]` — never tied to `result.bit`,
+/// the same free column #2's gold forges (`alu/lt/constraints.rs:46-48` pins only a[1..3]=0).
+/// So a malicious prover flips a branch's comparison ⇒ wrong control flow. The executor forces
+/// the target `BLTU` taken (so the pc-chain follows the wrong path); trace-gen forces `a_lt_b=1`
+/// in the branch cols/decision (`patch_cols`) and in the emitted SLTU comp event (`patch_comp`
+/// → the Lt chip's free a[0]). Full forge = both. `patch_cols` WITHOUT `patch_comp` is the
+/// neg-control isolating the free a[0]: the comp event stays honest (Lt provides a[0]=0) while
+/// the branch requests a_lt_b=1 ⇒ ALU-bus lookup imbalance ⇒ reject.
+#[cfg(test)]
+#[allow(dead_code)]
+pub(crate) mod branch_forge {
+    use std::sync::atomic::{AtomicBool, AtomicU64, Ordering};
+    static ACTIVE: AtomicBool = AtomicBool::new(false);
+    static PATCH_COLS: AtomicBool = AtomicBool::new(false);
+    static PATCH_COMP: AtomicBool = AtomicBool::new(false);
+    static TARGET_PC: AtomicU64 = AtomicU64::new(0);
