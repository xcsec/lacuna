+    /// Net REGIONAL balance per lookup key, summed over all chips and all chunks.
+    fn regional_key_balances(
+        pk: &BaseProvingKey<SC>,
+        chips: &[crate::machine::chip::MetaChip<F, C>],
+        records: &[crate::emulator::riscv::record::EmulationRecord],
+    ) -> std::collections::BTreeMap<crate::machine::debug::lookups::DebugLookupKey<F>, F> {
+        use crate::machine::{debug::lookups::DebugLookup, lookup::LookupScope};
+        use p3_field::FieldAlgebra;
+        let mut acc: std::collections::BTreeMap<_, F> = std::collections::BTreeMap::new();
+        for chip in chips {
+            for chunk in records {
+                let data = DebugLookup::<F>::debug_lookups::<SC, C>(
+                    pk,
+                    chip,
+                    chunk,
+                    LookupScope::Regional,
+                    None,
+                )
+                .lookup_data;
+                for (k, (_, bal)) in data {
+                    *acc.entry(k).or_insert(F::ZERO) += bal;
+                }
+            }
+        }
+        acc
+    }
