+// ============================================================================
+// GENERIC RECORD-LAYER PERTURBATION SWEEP  (method experiment, not a PoC)
+//
+// Question: can the base-ISA under-constraints be FOUND by a perturbation of the
+// EXECUTION RECORD that carries no per-bug knowledge?
+//
+// Operator (one, fixed, instruction-agnostic):
+//     at every architectural writeback of the static instruction at `pc`,
+//     replace the written value v by mu(v); the honest executor continues from
+//     the perturbed value and the honest witness generator regenerates the whole
+//     witness (all chips, all lookup multiplicities, public values, finalize).
+//
+// Schedule: pc ranges over the writeback sites an honest run visits (one site
+// per opcode class here); mu is a fixed menu (bit flip / +-k / limb shift / 0).
+//
+// Oracle (real prover + real verifier, all lookups ON):
+//     ACCEPT + committed public output != honest  -> soundness break
+//     ACCEPT + same output                        -> unbound writeback, no observable effect
+//     REJECT                                      -> the writeback is bound
+//     EXECFAIL                                    -> perturbation derailed the guest (inconclusive)
+// ============================================================================
+#[cfg(test)]
+mod wb_sweep {
+    use crate::{
+        chips::tests::test_rv64_emulate_with_opts,
+        compiler::riscv::{
+            compiler::{Compiler, SourceType},
+            opcode::Opcode,
+            program::Program,
+        },
+        configs::stark_config::KoalaBearPoseidon2,
+        emulator::{opts::EmulatorOpts, riscv::emulator::wb_perturb, stdin::EmulatorStdin},
+        instances::{chiptype::riscv_chiptype::RiscvChipType, machine::riscv::RiscvMachine},
+        machine::{machine::MachineBehavior, witness::ProvingWitness},
+        primitives::consts::RISCV_NUM_PVS,
+    };
+    use p3_koala_bear::KoalaBear;
+    use std::sync::Arc;
+
+    type SC = KoalaBearPoseidon2;
+    type C = RiscvChipType<KoalaBear>;
+
+    fn fib_elf_program() -> Arc<Program> {
+        let elf: &[u8] =
+            include_bytes!("../../../../compiler/test_elf/riscv64im-pico-fibnacci-elf");
+        Compiler::new(SourceType::RISCV, elf)
+            .expect("parse fib elf")
+            .compile()
+    }
+
+    fn stdin() -> EmulatorStdin<Program, Vec<u8>> {
+        let mut b = EmulatorStdin::<Program, Vec<u8>>::new_builder::<SC>();
+        b.write(&10u64);
+        b.finalize().0
+    }
+
+    /// Bounded emulation: a perturbation can derail the guest into a runaway loop,
+    /// so cap the cycle budget (honest fib is ~11k instructions). Exceeding it is an
+    /// EXECFAIL, not a verdict about the constraint system.
+    fn opts() -> EmulatorOpts {
+        EmulatorOpts {
+            max_cycles: Some(500_000),
+            ..EmulatorOpts::default()
+        }
+    }
+
+    fn is_writeback(op: Opcode) -> bool {
+        !matches!(
+            op,
+            Opcode::SB
+                | Opcode::SH
+                | Opcode::SW
+                | Opcode::SD
+                | Opcode::BEQ
+                | Opcode::BNE
+                | Opcode::BLT
+                | Opcode::BGE
+                | Opcode::BLTU
+                | Opcode::BGEU
+                | Opcode::ECALL
+                | Opcode::EBREAK
+                | Opcode::UNIMP
+        )
+    }
+
+    /// One (pc, nth, mu) run through the REAL pipeline. Returns (pv, verdict, hits).
+    ///
+    /// Verdicts are 4-state, and the panic payload is inspected so that a guest that
+    /// the perturbation DERAILED (unreachable/invalid-memory/emulation error) is not
+    /// confused with a witness the constraint system REJECTED.
+    fn run_case(
+        machine: &RiscvMachine<SC, C>,
+        pk: &crate::machine::keys::BaseProvingKey<SC>,
+        vk: &crate::machine::keys::BaseVerifyingKey<SC>,
+        program: &Arc<Program>,
+        pc: u64,
+        nth: i64,
+        mu_kind: usize,
+        mu_arg: i64,
+    ) -> (Option<Vec<u8>>, String, usize) {
+        let prev = std::panic::take_hook();
+        std::panic::set_hook(Box::new(|_| {}));
+        let out = std::panic::catch_unwind(std::panic::AssertUnwindSafe(|| {
+            wb_perturb::with(pc, nth, mu_kind, mu_arg, || {
+                let witness = ProvingWitness::<SC, C, Vec<u8>>::setup_for_riscv(
+                    program.clone(),
+                    stdin(),
+                    opts(),
+                    pk.clone(),
+                    vk.clone(),
+                );
+                let (proof, _r) = machine.prove_with_shape_report(&witness, None);
+                let pv = proof.pv_stream.clone();
+                let hits = wb_perturb::hits();
+                let res = machine.verify(&proof, vk).map_err(|e| format!("{e:?}"));
+                (pv, res, hits)
+            })
+        }));
+        std::panic::set_hook(prev);
+        match out {
+            Ok((pv, Ok(()), hits)) => (pv, "ACCEPT".to_string(), hits),
+            Ok((pv, Err(e), hits)) => (pv, format!("REJECT[verify] {}", trunc(&e)), hits),
+            Err(p) => {
+                let msg = p
+                    .downcast_ref::<String>()
+                    .cloned()
+                    .or_else(|| p.downcast_ref::<&str>().map(|s| s.to_string()))
+                    .unwrap_or_else(|| "<opaque>".to_string());
+                let kind = if msg.contains("Cumulative sum")
+                    || msg.contains("cumulative")
+                    || msg.contains("constraint")
+                    || msg.contains("Constraint")
+                    || msg.contains("lookup")
+                    || msg.contains("OodEvaluationMismatch")
+                    || msg.contains("InvalidProofShape")
+                {
+                    "REJECT[prove]"
+                } else {
+                    "EXECFAIL"
+                };
+                (None, format!("{kind} {}", trunc(&msg)), 0)
+            }
+        }
+    }
+
+    fn trunc(s: &str) -> String {
+        let s = s.replace('\n', " ");
+        s.chars().take(150).collect()
+    }
+
+    #[test]
+    #[ignore = "method experiment: generic record-layer writeback perturbation sweep; run in --release"]
+    fn wb_perturb_sweep_fib() {
+        let program = fib_elf_program();
+        let machine = RiscvMachine::new(SC::test(), RiscvChipType::all_chips(), RISCV_NUM_PVS);
+        let (pk, vk) = machine.setup_keys(&program);
+
+        // --- honest run: collect one writeback site per opcode class + honest pv ---
+        let records = test_rv64_emulate_with_opts(program.clone(), stdin(), opts());
+        // --- liveness of each writeback's destination register --------------------
+        // A perturbation on a LIVE destination changes the guest's later behaviour
+        // (control flow / addresses), so a rejection could mean "the guest derailed"
+        // rather than "the constraint system caught it". Restricting the sweep to
+        // DEAD destinations makes the perturbed execution bit-identical to the honest
+        // one everywhere except the single writeback under test — a clean 2-state
+        // oracle. This liveness analysis is generic (it reads only the record).
+        let flat: Vec<(usize, u64, Opcode, u8, Vec<u8>, bool)> = {
+            let mut v = vec![];
+            for r in &records {
+                for ev in &r.cpu_events {
+                    let ins = ev.instruction;
+                    let op = ins.opcode;
+                    let mut reads: Vec<u8> = vec![];
+                    if !ins.imm_b {
+                        reads.push(ins.op_b as u8);
+                    }
+                    if !ins.imm_c {
+                        reads.push(ins.op_c as u8);
+                    }
+                    // stores and branches read op_a as a SOURCE
+                    if matches!(op, Opcode::SB | Opcode::SH | Opcode::SW | Opcode::SD)
+                        || ins.is_branch_instruction()
+                    {
+                        reads.push(ins.op_a);
+                    }
+                    // ECALL reads the syscall registers, which are not encoded as operands.
+                    if matches!(op, Opcode::ECALL | Opcode::EBREAK) {
+                        reads.extend([5u8, 10, 11, 12, 13, 14, 15]);
+                    }
+                    let wb = is_writeback(op) && ins.op_a != 0;
+                    v.push((v.len(), ev.pc as u64, op, ins.op_a, reads, wb));
+                }
+            }
+            v
+        };
+        // dead(i) = rd of event i is never READ before being overwritten
+        let mut dead: Vec<bool> = vec![false; flat.len()];
+        let mut dead_final: Vec<bool> = vec![false; flat.len()];
+        for i in 0..flat.len() {
+            if !flat[i].5 {
+                continue;
+            }
+            let rd = flat[i].3;
+            let mut is_dead = true;
+            let mut rewritten = false;
+            for j in (i + 1)..flat.len() {
+                if flat[j].4.contains(&rd) {
+                    is_dead = false;
+                    break;
+                }
+                if flat[j].5 && flat[j].3 == rd {
+                    rewritten = true;
+                    break;
+                }
+            }
+            dead[i] = is_dead;
+            dead_final[i] = is_dead && !rewritten;
+        }
+        // occurrence index of each event at its own pc
+        let mut occ_at_pc: std::collections::BTreeMap<u64, usize> =
+            std::collections::BTreeMap::new();
+        let mut occ: Vec<usize> = vec![0; flat.len()];
+        for i in 0..flat.len() {
+            let e = occ_at_pc.entry(flat[i].1).or_insert(0);
+            occ[i] = *e;
+            *e += 1;
+        }
+        let n_wb = flat.iter().filter(|f| f.5).count();
+        println!(
+            "== honest run: {} instructions, {} register writebacks, {} DEAD ({} DEAD-FINAL) ==",
+            flat.len(),
+            n_wb,
+            dead.iter().filter(|d| **d).count(),
+            dead_final.iter().filter(|d| **d).count()
+        );
+
+        // per-(opcode, pc) dynamic counts
+        let mut per_site: std::collections::BTreeMap<(Opcode, u64), usize> =
+            std::collections::BTreeMap::new();
+        for r in &records {
+            for ev in &r.cpu_events {
+                let op = ev.instruction.opcode;
+                if !is_writeback(op) {
+                    continue;
+                }
+                *per_site.entry((op, ev.pc as u64)).or_insert(0) += 1;
+            }
+        }
+        // For each opcode class keep up to SITES_PER_OP distinct static sites, preferring
+        // the LEAST-executed ones (a perturbation on a hot site derails the guest).
+        const SITES_PER_OP: usize = usize::MAX;
+        let mut by_op: std::collections::BTreeMap<Opcode, Vec<(u64, usize)>> =
+            std::collections::BTreeMap::new();
+        for ((op, pc), n) in &per_site {
+            by_op.entry(*op).or_default().push((*pc, *n));
+        }
+        let _ = &by_op;
+        // DEAD-destination sites, up to SITES_PER_OP per opcode class, preferring
+        // DEAD-FINAL ones (their value survives into the committed final memory image).
+        let mut sites: Vec<(Opcode, u64, i64, bool)> = vec![];
+        {
+            let mut per_op: std::collections::BTreeMap<Opcode, usize> =
+                std::collections::BTreeMap::new();
+            let mut order: Vec<usize> = (0..flat.len()).filter(|i| dead[*i]).collect();
+            order.sort_by_key(|i| (!dead_final[*i], *i));
+            for i in order {
+                let op = flat[i].2;
+                let c = per_op.entry(op).or_insert(0);
+                if *c >= SITES_PER_OP {
+                    continue;
+                }
+                *c += 1;
+                sites.push((op, flat[i].1, occ[i] as i64, dead_final[i]));
+            }
+            sites.sort_by_key(|(op, pc, _, _)| (*op, *pc));
+        }
+        println!("== distinct static writeback sites: {} ==", per_site.len());
+
+        let honest_witness = ProvingWitness::<SC, C, Vec<u8>>::setup_for_riscv(
+            program.clone(),
+            stdin(),
+            opts(),
+            pk.clone(),
+            vk.clone(),
+        );
+        let (honest_proof, _) = machine.prove_with_shape_report(&honest_witness, None);
+        machine
+            .verify(&honest_proof, &vk)
+            .expect("honest must verify");
+        let honest_pv = honest_proof.pv_stream.clone();
+        println!("HONEST pv = {honest_pv:x?}");
+
+        // --- sweep: mu = XOR bit0, at the LAST dynamic execution of each site ---
+        // (perturbing every execution of a hot instruction derails the guest; the
+        //  last occurrence is the least-derailing generic choice.)
+        println!("\n== SWEEP: mu = XOR(bit 0) on DEAD destinations (execution unchanged) ==");
+        let mut table: Vec<(String, u64, String, bool, usize)> = vec![];
+        for (op, pc, nth, dfin) in &sites {
+            let nth = *nth;
+            let (pv, verdict, hits) = run_case(
+                &machine,
+                &pk,
+                &vk,
+                &program,
+                *pc,
+                nth,
+                wb_perturb::MU_XORBIT,
+                0,
+            );
+            let diff = pv != honest_pv;
+            println!(
+                "  {:<8} pc={:#010x} occ={:<5} {:<11} hits={:<3} {}  pv_changed={}",
+                format!("{op:?}"),
+                pc,
+                nth,
+                if *dfin { "DEAD-FINAL" } else { "dead" },
+                hits,
+                verdict,
+                diff
+            );
+            table.push((format!("{op:?}"), *pc, verdict, diff, hits));
+        }
+
+        println!("\n== SUMMARY (4-state oracle) ==");
+        let n_acc = table
+            .iter()
+            .filter(|t| t.2.starts_with("ACCEPT") && t.4 > 0)
+            .count();
+        let n_noop = table
+            .iter()
+            .filter(|t| t.4 == 0 && t.2.starts_with("ACCEPT"))
+            .count();
+        let n_rej = table.iter().filter(|t| t.2.starts_with("REJECT")).count();
+        let n_fail = table.iter().filter(|t| t.2.starts_with("EXECFAIL")).count();
+        println!(
+            "  ACCEPT(perturbed) = {n_acc}   REJECT = {n_rej}   EXECFAIL = {n_fail}   NO-OP(hits=0) = {n_noop}   total = {}",
+            table.len()
+        );
+        for t in table
+            .iter()
+            .filter(|t| t.2.starts_with("ACCEPT") && t.4 > 0)
+        {
+            println!(
+                "  *** UNBOUND WRITEBACK: {} @ {:#x}  (hits={}, pv_changed={})",
+                t.0, t.1, t.4, t.3
+            );
+        }
+    }
+}
+
+// ============================================================================
+// MUTATION-MENU MATRIX — does the per-limb operator family (v ± B^i) LOCALIZE
+// the missing equation to a limb index, and is `next_pc` reachable as a field?
+//
+// For each site we sweep the whole class-A menu and print one verdict per mu.
+// A chip that binds its output rejects EVERY mu; a chip with a partially bound
+// output (e.g. pico SRLW pins the sign-extension limbs a[2],a[3] but leaves the
+// low limbs free) accepts EXACTLY the mus that move an unbound limb — so the
+// accepted-mu set reads off WHICH limbs the AIR forgot.
+// ============================================================================
+#[cfg(test)]
+mod wb_menu {
+    use crate::{
+        chips::tests::test_rv64_emulate_with_opts,
+        compiler::riscv::{
+            compiler::{Compiler, SourceType},
+            opcode::Opcode,
+            program::Program,
+        },
+        configs::stark_config::KoalaBearPoseidon2,
+        emulator::{opts::EmulatorOpts, riscv::emulator::wb_perturb, stdin::EmulatorStdin},
+        instances::{chiptype::riscv_chiptype::RiscvChipType, machine::riscv::RiscvMachine},
+        machine::{machine::MachineBehavior, witness::ProvingWitness},
+        primitives::consts::RISCV_NUM_PVS,
+    };
+    use p3_koala_bear::KoalaBear;
+    use std::sync::Arc;
+
+    type SC = KoalaBearPoseidon2;
+    type C = RiscvChipType<KoalaBear>;
+
+    fn fib_elf_program() -> Arc<Program> {
+        let elf: &[u8] =
+            include_bytes!("../../../../compiler/test_elf/riscv64im-pico-fibnacci-elf");
+        Compiler::new(SourceType::RISCV, elf)
+            .expect("elf")
+            .compile()
+    }
+    fn stdin() -> EmulatorStdin<Program, Vec<u8>> {
+        let mut b = EmulatorStdin::<Program, Vec<u8>>::new_builder::<SC>();
+        b.write(&10u64);
+        b.finalize().0
+    }
+    fn opts() -> EmulatorOpts {
+        EmulatorOpts {
+            max_cycles: Some(500_000),
+            ..EmulatorOpts::default()
+        }
+    }
+
+    /// class-A menu: (label, mu_kind, mu_arg)
+    fn menu() -> Vec<(&'static str, usize, i64)> {
+        vec![
+            ("xor b0", wb_perturb::MU_XORBIT, 0),
+            ("+B^0", wb_perturb::MU_ADDK, 1),
+            ("-B^0", wb_perturb::MU_ADDK, -1),
+            ("+B^1", wb_perturb::MU_ADDK, 1 << 16),
+            ("-B^1", wb_perturb::MU_ADDK, -(1 << 16)),
+            ("+B^2", wb_perturb::MU_ADDK, 1 << 32),
+            ("+B^3", wb_perturb::MU_ADDK, 1 << 48),
+            ("xor b31", wb_perturb::MU_XORBIT, 31),
+            ("zero", wb_perturb::MU_ZERO, 0),
+        ]
+    }
+
+    fn one(
+        machine: &RiscvMachine<SC, C>,
+        pk: &crate::machine::keys::BaseProvingKey<SC>,
+        vk: &crate::machine::keys::BaseVerifyingKey<SC>,
+        program: &Arc<Program>,
+        pc: u64,
+        nth: i64,
+        mu_kind: usize,
+        mu_arg: i64,
+        pc_xor: u64,
+    ) -> char {
+        let prev = std::panic::take_hook();
+        std::panic::set_hook(Box::new(|_| {}));
+        let out = std::panic::catch_unwind(std::panic::AssertUnwindSafe(|| {
+            wb_perturb::with_pc(pc, nth, mu_kind, mu_arg, pc_xor, || {
+                let w = ProvingWitness::<SC, C, Vec<u8>>::setup_for_riscv(
+                    program.clone(),
+                    stdin(),
+                    opts(),
+                    pk.clone(),
+                    vk.clone(),
+                );
+                let (proof, _r) = machine.prove_with_shape_report(&w, None);
+                let hits = wb_perturb::hits();
+                let ok = machine.verify(&proof, vk).is_ok();
+                (ok, hits)
+            })
+        }));
+        std::panic::set_hook(prev);
+        match out {
+            Ok((true, h)) if h > 0 => 'A', // ACCEPTED a perturbed witness
+            Ok((true, _)) => '-',          // mutation was a no-op
+            Ok((false, _)) => 'R',
+            Err(_) => 'r', // rejected inside prove, or guest derailed
+        }
+    }
+
+    #[test]
+    #[ignore = "method experiment: class-A mutation-menu matrix + next_pc axis; run in --release"]
+    fn wb_perturb_menu_matrix() {
+        let program = fib_elf_program();
+        let machine = RiscvMachine::new(SC::test(), RiscvChipType::all_chips(), RISCV_NUM_PVS);
+        let (pk, vk) = machine.setup_keys(&program);
+        let records = test_rv64_emulate_with_opts(program.clone(), stdin(), opts());
+
+        const FOCUS: [Opcode; 8] = [
+            Opcode::ADD,
+            Opcode::SLL,
+            Opcode::SRL,
+            Opcode::SRLW,
+            Opcode::SLTU,
+            Opcode::MUL,
+            Opcode::LD,
+            Opcode::JALR,
+        ];
+        // (opcode, pc, occurrence) — 2 coldest static sites per focus opcode
+        let mut counts: std::collections::BTreeMap<(Opcode, u64), usize> = Default::default();
+        for r in &records {
+            for ev in &r.cpu_events {
+                *counts
+                    .entry((ev.instruction.opcode, ev.pc as u64))
+                    .or_insert(0) += 1;
+            }
+        }
+        let mut sites: Vec<(Opcode, u64)> = vec![];
+        for op in FOCUS {
