+/// TEST-ONLY **generic writeback perturbation** — the record-layer fuzzing hook.
+///
+/// Unlike the bug-specific `sltu_forge` / `pclk_forge` / `n1_forge` seams above, this
+/// hook contains NO knowledge of any instruction, operand pattern, chip or column.
+/// Its complete specification is:
+///
+/// > at every architectural writeback of the static instruction at address `pc`,
+/// > replace the value the executor writes back with `mu(value)`, then let the
+/// > HONEST executor and the HONEST witness generator carry that value everywhere.
+///
+/// The schedule `(pc, mu)` is swept mechanically over the sites an honest run
+/// visits; `mu` ranges over a fixed, instruction-agnostic menu (bit flip, +-k,
+/// limb shift, zero). Because the executor continues from the perturbed value,
+/// every downstream record (register file, memory, CPU/ALU events, byte-lookup
+/// multiplicities, public values, memory finalize) is REGENERATED by the VM's own
+/// code, so all cross-chip buses re-balance for free.
+///
+/// Oracle: if the REAL verifier accepts the resulting proof, the chip that produced
+/// that writeback does not bind its architectural output to f(inputs).
+#[cfg(any(test, feature = "zkvm-fuzz-hooks"))]
+pub mod wb_perturb {
+    use std::sync::atomic::{AtomicBool, AtomicI64, AtomicU64, AtomicUsize, Ordering};
+    const R: Ordering = Ordering::Relaxed;
+
+    /// Instruction-agnostic mutation menu (the "regular" part of the perturbation).
+    pub const MU_XORBIT: usize = 0;
+    #[allow(dead_code)]
+    pub const MU_ADDK: usize = 1;
+    #[allow(dead_code)]
+    pub const MU_SHL: usize = 2;
+    #[allow(dead_code)]
+    pub const MU_ZERO: usize = 3;
+    /// Set the write-back to a literal boundary value (ENC-E2 with beta != 0).
+    #[allow(dead_code)]
+    pub const MU_SET: usize = 4;
+
+    static ENABLED: AtomicBool = AtomicBool::new(false);
+    static TARGET_PC: AtomicU64 = AtomicU64::new(u64::MAX);
+    static MU_KIND: AtomicUsize = AtomicUsize::new(MU_XORBIT);
+    static MU_ARG: AtomicI64 = AtomicI64::new(0);
+
+    static TARGET_NTH: AtomicI64 = AtomicI64::new(-1); // -1 = every execution of the site
+    static SEEN: AtomicI64 = AtomicI64::new(0);
+    static ARMED: AtomicBool = AtomicBool::new(false);
+    static FIRED: AtomicBool = AtomicBool::new(false);
+    static HONEST: AtomicU64 = AtomicU64::new(0);
+    static FORGED: AtomicU64 = AtomicU64::new(0);
+    static HITS: AtomicUsize = AtomicUsize::new(0);
+    static TOTAL: AtomicUsize = AtomicUsize::new(0);
+    /// Class-B/A' operator: XOR mask applied to this instruction's `next_pc`
+    /// (0 = off). Exercises the "identity/effect field = pc" axis.
+    static PC_XOR: AtomicU64 = AtomicU64::new(0);
+
+    fn install(pc: u64, nth: i64, mu_kind: usize, mu_arg: i64, pc_xor: u64) {
+        PC_XOR.store(pc_xor, R);
+        TARGET_PC.store(pc, R);
+        TARGET_NTH.store(nth, R);
+        SEEN.store(0, R);
+        MU_KIND.store(mu_kind, R);
+        MU_ARG.store(mu_arg, R);
+        ARMED.store(false, R);
+        FIRED.store(false, R);
+        HITS.store(0, R);
+        TOTAL.store(0, R);
+        ENABLED.store(true, R);
+    }
+    fn clear() {
+        ENABLED.store(false, R);
+        ARMED.store(false, R);
+        FIRED.store(false, R);
+        TARGET_PC.store(u64::MAX, R);
+    }
+    /// Number of writebacks actually perturbed (0 => the site never executed).
+    pub fn hits() -> usize {
+        HITS.load(R)
+    }
+    /// Number of times the target pc was entered (across ALL emulation passes).
+    #[allow(dead_code)]
+    pub fn seen() -> i64 {
+        SEEN.load(R)
+    }
+    #[allow(dead_code)]
+    pub fn total() -> usize {
+        TOTAL.load(R)
+    }
+
+    /// Run `body` with the writeback at `pc` perturbed by `mu`. Cleared on return/panic.
+    pub fn with<Res>(
+        pc: u64,
+        nth: i64,
+        mu_kind: usize,
+        mu_arg: i64,
+        body: impl FnOnce() -> Res,
+    ) -> Res {
+        install(pc, nth, mu_kind, mu_arg, 0);
+        struct Clear;
+        impl Drop for Clear {
+            fn drop(&mut self) {
+                clear();
+            }
+        }
+        let _c = Clear;
+        body()
+    }
+
+    /// Same as `with`, but ALSO (or instead) XORs the target instruction's `next_pc`.
+    pub fn with_pc<Res>(
+        pc: u64,
+        nth: i64,
+        mu_kind: usize,
+        mu_arg: i64,
+        pc_xor: u64,
+        body: impl FnOnce() -> Res,
+    ) -> Res {
+        install(pc, nth, mu_kind, mu_arg, pc_xor);
+        struct Clear2;
+        impl Drop for Clear2 {
+            fn drop(&mut self) {
+                clear();
+                PC_XOR.store(0, R);
+            }
+        }
+        let _c = Clear2;
+        body()
+    }
+
+    /// Perturb the architectural `next_pc` of the armed instruction.
+    #[inline]
+    pub fn next_pc(v: u64) -> u64 {
+        let x = PC_XOR.load(R);
+        if !ENABLED.load(R) || !ARMED.load(R) || x == 0 {
+            return v;
+        }
+        HITS.fetch_add(1, R);
+        v ^ x
+    }
+
+    /// Called once at the start of every emulated instruction.
+    #[inline]
+    pub fn begin(pc: u64) {
+        if !ENABLED.load(R) {
+            return;
+        }
+        TOTAL.fetch_add(1, R);
+        FIRED.store(false, R);
+        if pc != TARGET_PC.load(R) {
+            ARMED.store(false, R);
+            return;
+        }
+        let n = SEEN.fetch_add(1, R);
+        let want = TARGET_NTH.load(R);
+        ARMED.store(want < 0 || n == want, R);
+    }
+
+    #[inline]
+    fn mutate(v: u64) -> u64 {
+        let arg = MU_ARG.load(R);
+        match MU_KIND.load(R) {
+            MU_XORBIT => v ^ (1u64 << ((arg as u64) & 63)),
+            MU_ADDK => v.wrapping_add(arg as u64),
+            MU_SHL => v.wrapping_shl((arg as u64 & 63) as u32),
+            MU_SET => arg as u64,
+            _ => 0,
+        }
+    }
+
+    /// THE choke point: every architectural register writeback passes through here.
+    #[inline]
+    pub fn on_reg_write(v: u64) -> u64 {
+        if !ENABLED.load(R) || !ARMED.load(R) || FIRED.load(R) {
+            return v;
+        }
+        let f = mutate(v);
+        if f == v {
+            return v;
+        }
+        HONEST.store(v, R);
+        FORGED.store(f, R);
+        FIRED.store(true, R);
+        HITS.fetch_add(1, R);
+        f
+    }
+
+    /// Record-emission sites that carry the SAME architectural output value
+    /// (CPU event `a`, ALU event `a`). Keeps the record internally coherent.
+    #[inline]
+    pub fn subst(v: u64) -> u64 {
+        if ENABLED.load(R) && FIRED.load(R) && v == HONEST.load(R) {
+            FORGED.load(R)
+        } else {
+            v
+        }
+    }
+
+    pub fn honest_value() -> u64 {
+        HONEST.load(R)
+    }
+
+    pub fn forged_value() -> u64 {
+        FORGED.load(R)
+    }
+}
