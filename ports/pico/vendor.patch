+    /// N4 forge_hook: rewrite the DivRem DIVUW(10,3) row to the forged sign-ext
+    /// quotient (quot_msb.msb=1 + quotient[2,3]=0xFFFF), and REBALANCE every Byte
+    /// range-check the DivRem `generate_main` emits whose value the forge changed.
+    ///
+    /// The residual (found via `e2e_divuw_diag_residual`) is: the DivRem chip's
+    /// looking side (AIR `slice_range_check_u16(&quotient, is_real)`, constraints
+    /// line 604) requests U16(quotient[i]) for the FORGED limbs [3,0,0xFFFF,0xFFFF]
+    /// while the Byte provider was generated from the HONEST quotient [3,0,0,0]
+    /// (`generate_main` line 368-373 uses the computed quotient=3). That is the
+    /// ONLY looking-side change (quot_msb itself is never eval'd), so we mirror
+    /// exactly that one range-check's delta: +2·U16(0xFFFF), −2·U16(0).
+    fn divuw_forge_hook(traces: &mut Vec<(String, RowMajorMatrix<F>)>) {
+        divuw_forge_hook_inner(traces, true);
+    }
+
+    /// `fix_dangling`: when true, also cancel the pre-existing `quot_msb.populate`
+    /// dangling U16(0) provide (required for ANY balanced divuw witness). The
+    /// negative control passes `false` to leave that −1 residual → verifier REJECTS.
+    fn divuw_forge_hook_inner(traces: &mut Vec<(String, RowMajorMatrix<F>)>, fix_dangling: bool) {
+        use crate::chips::chips::{
+            alu::divrem::columns::{DivRemCols, NUM_DIVREM_COLS},
+            byte::{
+                columns::NUM_BYTE_MULT_COLS,
+                event::{ByteLookupEvent, ByteRecordBehavior},
+            },
+        };
+        // (1) Forge the DivRem DIVUW(10,3) row: quot_msb.msb=1 + quotient[2,3]=0xFFFF.
+        let mut matched = false;
+        if let Some(di) = traces.iter().position(|(n, _)| n == "DivRem") {
+            let mat = &mut traces[di].1;
+            let nrows = mat.values.len() / NUM_DIVREM_COLS;
+            for row in 0..nrows {
+                let base = row * NUM_DIVREM_COLS;
+                let cols: &mut DivRemCols<F> =
+                    mat.values[base..base + NUM_DIVREM_COLS].borrow_mut();
+                let v = &mut cols.values[0];
+                if v.is_divuw == F::ONE
+                    && v.b.0[0] == F::from_canonical_u32(10)
+                    && v.c.0[0] == F::from_canonical_u32(3)
+                {
+                    v.quot_msb.msb = F::ONE;
+                    v.quotient.0[2] = F::from_canonical_u32(0xFFFF);
+                    v.quotient.0[3] = F::from_canonical_u32(0xFFFF);
+                    matched = true;
+                }
+            }
+        }
+        if !matched {
+            return;
+        }
+        // (2) Rebalance the Byte U16Range provider for EVERY DivRem generate_main
+        //     byte event the forge changed. Build the forged vs honest byte-event
+        //     multisets and apply the delta to the Byte multiplicity trace.
+        use crate::compiler::riscv::opcode::ByteOpcode;
+        let mut forged: Vec<ByteLookupEvent> = vec![];
+        let mut honest: Vec<ByteLookupEvent> = vec![];
+        // The quotient range-check (generate_main line 368-373): forged limbs vs
+        // honest limbs. This is the sole looking-side change from the sign-ext forge.
+        forged.add_u16_range_checks(&[3u16, 0, 0xFFFF, 0xFFFF]);
+        honest.add_u16_range_checks(&[3u16, 0, 0, 0]);
+        let mut delta: std::collections::HashMap<ByteLookupEvent, i64> = Default::default();
+        for e in &forged {
+            *delta.entry(*e).or_insert(0) += 1;
+        }
+        for e in &honest {
+            *delta.entry(*e).or_insert(0) -= 1;
+        }
+        // (3) Cancel the pre-existing `quot_msb.populate` DANGLING PROVIDE. For word
+        //     ops, DivRem `generate_main` (traces.rs:219-220) calls
+        //     `quot_msb.populate((quotient>>16) as u16)`, which emits
+        //     `add_u16_range_check(2*(quotient>>16))` = U16Range(0) here, but the AIR
+        //     NEVER evaluates quot_msb (constraints.rs MSB section 570-599 lists only
+        //     b/c/rem_msb), so nothing looks it up. The honest Byte trace therefore
+        //     over-provides U16Range(0) by 1 (verified: honest DIVUW itself has this
+        //     -1 imbalance and fails to verify). A balanced witness — which any
+        //     malicious prover controls — must remove that dangling provide.
+        if fix_dangling {
+            let quot_msb_dangling = ByteLookupEvent::new(ByteOpcode::U16Range, 0, 0, 0, 0);
+            *delta.entry(quot_msb_dangling).or_insert(0) -= 1;
+        }
+        if let Some(bi) = traces.iter().position(|(n, _)| n == "Byte") {
+            let bt = &mut traces[bi].1;
+            for (e, d) in delta {
+                if d == 0 {
+                    continue;
+                }
+                let idx = byte_row_index(&e) * NUM_BYTE_MULT_COLS + e.opcode as usize;
+                let cur = bt.values[idx];
+                bt.values[idx] = if d >= 0 {
+                    cur + F::from_canonical_u64(d as u64)
+                } else {
+                    cur - F::from_canonical_u64((-d) as u64)
+                };
+            }
+        }
+    }
