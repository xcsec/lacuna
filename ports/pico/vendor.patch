+    // ========================================================================
+    // ROUTE A — REPORTER-GUIDED LOCAL REPAIR of the SLT under-constraint (C1).
+    //
+    // Goal: produce a witness where the SLTU committed output is FORGED
+    // (a[0]=1 while the true 5<3 result is 0) that the REAL verifier ACCEPTS,
+    // by REPAIRING the bus imbalance a naive injection causes rather than by
+    // hand-crafting the forge.
+    //
+    // Mechanism (established by reading the code):
+    //   * The malicious executor (`sltu_forge`) sets event.a = 1 for the user
+    //     comparison 5<3. That makes the WHOLE trace self-consistent on the
+    //     value 1 — register write / store / COMMIT / memory-finalize / Global
+    //     septic digest all carry 1, and the CPU<->LT `alu` bus balances on 1.
+    //   * The ONLY thing it corrupts is the LT gadget's `bit` column: populate
+    //     sets `bit = a_u16` (lt_word_u16.rs:96), so bit becomes 1. The gadget
+    //     constraint then range-checks diff = (b_comp - c_comp) + bit*2^16 =
+    //     (5-3) + 1*2^16 = 65538, which is OUT of the u16 range [0,2^16). The
+    //     Byte chip provides U16Range(2) (populate's `add_u16_range_check(diff)`
+    //     at line 98 uses diff = comparison_limbs[0]-comparison_limbs[1] = 2,
+    //     computed WITHOUT the bit), so the LT gadget's looking side (65538) has
+    //     no provider -> a single U16Range regional-lookup imbalance.
+    //   * REPAIR: in the LT chip trace, restore the gadget's `bit` to the value
+    //     that lands its OWN range-check diff back in [0,2^16) — while LEAVING
+    //     cols.a[0]=1 forged. That re-points the looking side at U16Range(2),
+    //     which the Byte chip ALREADY provides (populate emitted it regardless
+    //     of the forge), so NO Byte-multiplicity edit is needed.
+    //
+    // `e2e_slt_diag_forge_imbalance` uses the failure reporter to SHOW that the
+    // executor forge leaves exactly one regional imbalance (a U16Range key).
+    // `e2e_slt_repair_recovers` performs the repair and checks verify ACCEPTS
+    // pv=[1,0,0,0].
+    // ========================================================================
+
+    /// Emulate ltguest with the malicious SLTU executor forge active and apply
+    /// `run_extra_records` (so Byte/other derived events are present), returning
+    /// the records exactly as the prover would see them.
+    fn ltguest_forged_records(
+        chips: &[crate::machine::chip::MetaChip<F, C>],
+        opts: EmulatorOpts,
+    ) -> Vec<crate::emulator::riscv::record::EmulationRecord> {
+        let program = ltguest_program();
+        let stdin = ltguest_stdin();
+        let mut records = crate::emulator::riscv::emulator::sltu_forge::with_forge(|| {
+            crate::chips::tests::test_rv64_emulate_with_opts(program, stdin, opts)
+        });
+        for r in &mut records {
+            crate::chips::tests::run_extra_records(chips, r);
+        }
+        records
+    }
+
+    /// Force the whole ltguest execution into a SINGLE chunk so the REGIONAL
+    /// lookup argument must fully close on its own (no cross-chunk memory routed
+    /// to the Global scope). This makes `debug_regional_lookups` a faithful
+    /// per-chunk balance check instead of the noisy multi-chunk view.
+    fn single_chunk_opts() -> EmulatorOpts {
+        EmulatorOpts {
+            chunk_size: 1 << 24,
+            chunk_batch_size: 1 << 12,
+            ..EmulatorOpts::default()
+        }
+    }
