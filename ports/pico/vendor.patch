+        let m = menu();
+        println!("\n== class-A menu matrix (A=accepted forged witness, R/r=rejected, -=no-op) ==");
+        print!("{:<9} {:<12}", "opcode", "pc");
+        for (l, _, _) in &m {
+            print!(" {:>8}", l);
+        }
+        println!();
+        for (op, pc) in &sites {
+            print!("{:<9} {:#012x}", format!("{op:?}"), pc);
+            for (_, k, a) in &m {
+                let v = one(&machine, &pk, &vk, &program, *pc, 0, *k, *a, 0);
+                print!(" {:>8}", v);
+            }
+            println!();
+        }
+
+        println!("\n== next_pc axis (XOR bit0 = the JALR `& ~1` rule; XOR bit2 = +/-4) ==");
+        for (op, pc) in sites
+            .iter()
+            .filter(|(o, _)| matches!(o, Opcode::JALR | Opcode::ADD | Opcode::LD))
+        {
+            for x in [1u64, 4u64] {
+                // MU_ADDK with delta 0 is a no-op on the writeback, so this run
+                // isolates the next_pc axis.
+                let v = one(
+                    &machine,
+                    &pk,
+                    &vk,
+                    &program,
+                    *pc,
+                    0,
+                    wb_perturb::MU_ADDK,
+                    0,
+                    x,
+                );
+                println!(
+                    "  {:<8} pc={:#012x}  next_pc ^= {}  -> {}",
+                    format!("{op:?}"),
+                    pc,
+                    x,
+                    v
+                );
+            }
+        }
+    }
+}
