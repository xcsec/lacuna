+/// P-CLK (free data-mem access timestamp) forge driver. The CPU->mem "Memory" lookup
+/// (`riscv_cpu/constraints.rs` looking ↔ `read_write` looked) carries opcode+operands+selectors
+/// but NO clk/chunk, so the read_write chip's (chunk,clk) timestamp is a FREE witness
+/// (`read_write/columns.rs:27/29`, used raw on the offline-memory bus at `constraints.rs:221-222`).
+/// The executor arm returns the FIRST store's value V1 for the target load (so rd=V1 propagates
+/// to the commit); the trace hook reorders that load's clk to sit between the two stores and
+/// re-chains the second store, so the offline-memory argument accepts V1 as the value read.
+/// Neg-control = executor arm WITHOUT the trace reorder ⇒ load value≠prev_value ⇒ reject,
+/// isolating the free clk as the sole lever.
+
+/// LACUNA — GENERIC BINDING-MUTATION OPERATOR (BIND-O1 / store--load timestamp).
+///
+/// Bug-agnostic. Armed on a static load pc, it makes the executor deliver the
+/// *second-most-recent* value written to that address instead of the most recent one
+/// (a "stale load"). The witness generator then derives every value column of the
+/// memory row from that stale value. The companion post-trace-generation hook swaps
+/// the free memory-access `clk` of that load row with the immediately preceding
+/// access to the same address, which
+///   (a) makes the stale value the one the offline-memory argument is obliged to
+///       carry (the load now chains off the earlier write), and
+///   (b) preserves the timestamp-difference multiset exactly (an adjacent
+///       transposition), so no range-check multiplicity has to be rebalanced.
+/// The opcode/CPU component keeps the honest execution order; only the memory
+/// component is handed the rewritten record — i.e. this is a *binding* mutation
+/// with S = {MemoryReadWrite} and C\S = the rest of the machine.
+#[cfg(test)]
+#[allow(dead_code)]
+pub(crate) mod stale_load {
+    use std::sync::{
+        atomic::{AtomicBool, AtomicU64, Ordering},
+        Mutex,
+    };
+    const R: Ordering = Ordering::Relaxed;
+
+    static ENABLED: AtomicBool = AtomicBool::new(false);
+    static TARGET_PC: AtomicU64 = AtomicU64::new(0);
+    static FIRED: AtomicBool = AtomicBool::new(false);
+    static TARGET_ADDR: AtomicU64 = AtomicU64::new(0);
+    static HONEST_VALUE: AtomicU64 = AtomicU64::new(0);
+    static STALE_VALUE: AtomicU64 = AtomicU64::new(0);
+    /// Encoded memory-trace clk of the substituted row, recorded by the witness generator.
+    static ROW_CLK: AtomicU64 = AtomicU64::new(u64::MAX);
+    static ROW_CHUNK: AtomicU64 = AtomicU64::new(u64::MAX);
+    /// Per-address write history of the current emulation.
+    static HISTORY: Mutex<Option<std::collections::HashMap<u64, Vec<u64>>>> = Mutex::new(None);
+
+    pub(crate) fn active() -> bool {
+        ENABLED.load(R)
+    }
+    pub(crate) fn fired() -> bool {
+        FIRED.load(R)
+    }
+    pub(crate) fn target_pc() -> u64 {
+        TARGET_PC.load(R)
+    }
+    pub(crate) fn target_addr() -> u64 {
+        TARGET_ADDR.load(R)
+    }
+    pub(crate) fn honest_value() -> u64 {
+        HONEST_VALUE.load(R)
+    }
+    pub(crate) fn stale_value() -> u64 {
+        STALE_VALUE.load(R)
+    }
+    pub(crate) fn row_clk() -> u64 {
+        ROW_CLK.load(R)
+    }
+    pub(crate) fn row_chunk() -> u64 {
+        ROW_CHUNK.load(R)
+    }
+    pub(crate) fn set_row(clk: u64, chunk: u64) {
+        ROW_CLK.store(clk, R);
+        ROW_CHUNK.store(chunk, R);
+    }
+
+    /// Called on every architectural memory write. Generic; no bug knowledge.
+    #[inline]
+    pub(crate) fn record_write(addr: u64, value: u64) {
+        if !ENABLED.load(R) {
+            return;
+        }
+        let mut g = HISTORY.lock().unwrap_or_else(|e| e.into_inner());
+        let h = g.get_or_insert_with(Default::default);
+        h.entry(addr).or_default().push(value);
+    }
+
+    /// Called on every architectural doubleword load. Returns the stale value to
+    /// deliver, or None to keep the honest one.
+    #[inline]
+    pub(crate) fn on_load(pc: u64, addr: u64, honest: u64) -> Option<u64> {
+        if !ENABLED.load(R) || FIRED.load(R) || pc != TARGET_PC.load(R) {
+            return None;
+        }
+        let g = HISTORY.lock().unwrap_or_else(|e| e.into_inner());
+        let h = g.as_ref()?;
+        let v = h.get(&addr)?;
+        if v.len() < 2 {
+            return None;
+        }
+        let stale = v[v.len() - 2];
+        if stale == honest || v[v.len() - 1] != honest {
+            return None;
+        }
+        FIRED.store(true, R);
+        TARGET_ADDR.store(addr, R);
+        HONEST_VALUE.store(honest, R);
+        STALE_VALUE.store(stale, R);
+        Some(stale)
+    }
+
+    /// Run `body` with the stale-load operator armed at `pc`.
+    pub(crate) fn with<Res>(pc: u64, body: impl FnOnce() -> Res) -> Res {
+        TARGET_PC.store(pc, R);
+        FIRED.store(false, R);
+        TARGET_ADDR.store(0, R);
+        HONEST_VALUE.store(0, R);
+        STALE_VALUE.store(0, R);
+        ROW_CLK.store(u64::MAX, R);
+        ROW_CHUNK.store(u64::MAX, R);
+        *HISTORY.lock().unwrap_or_else(|e| e.into_inner()) = Some(Default::default());
+        ENABLED.store(true, R);
+        struct Clear;
+        impl Drop for Clear {
+            fn drop(&mut self) {
+                ENABLED.store(false, R);
+                FIRED.store(false, R);
+                TARGET_PC.store(0, R);
+                *HISTORY.lock().unwrap_or_else(|e| e.into_inner()) = None;
+            }
+        }
+        let _c = Clear;
+        body()
+    }
+}
