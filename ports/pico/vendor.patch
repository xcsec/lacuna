+    #[test]
+    #[ignore = "HEADLINE N2: full-machine SRL shift-amount decoupling forge; run in --release"]
+    fn e2e_srl_shiftamt_forge_accepted() {
+        crate::machine::logger::setup_logger();
+        let program = srl_n2_program();
+        let machine = RiscvMachine::new(SC::test(), RiscvChipType::all_chips(), RISCV_NUM_PVS);
+        let (pk, vk) = machine.setup_keys(&program);
+
+        let hook: forge_hook::Hook =
+            Box::new(|traces: &mut Vec<(String, RowMajorMatrix<F>)>| srl_n2_forge_hook(traces));
+
+        let (pv, res) = crate::emulator::riscv::emulator::sltu_forge::with_forge(|| {
+            forge_hook::with_hook(hook, || {
+                let witness = ProvingWitness::<SC, C, Vec<u8>>::setup_for_riscv(
+                    program.clone(),
+                    srl_n2_stdin(),
+                    EmulatorOpts::default(),
+                    pk.clone(),
+                    vk.clone(),
+                );
+                let (proof, _r) = machine.prove_with_shape_report(&witness, None);
+                let pv = proof.pv_stream.clone();
+                println!("SRL N2 FORGED pv_stream (before verify): {pv:x?}");
+                let res: Result<(), String> =
+                    match std::panic::catch_unwind(std::panic::AssertUnwindSafe(|| {
+                        machine.verify(&proof, &vk)
+                    })) {
+                        Ok(inner) => inner.map_err(|e| format!("{e:?}")),
+                        Err(_) => Err("verify panicked (bus/constraint failure)".to_string()),
+                    };
+                (pv, res)
+            })
+        });
+
+        println!("SRL N2 FORGED pv_stream: {pv:x?}");
+        println!("SRL N2 FORGED verify:    {res:?}");
+        // honest 0xFF00>>4 = 0xFF0 -> [F0,0F,0,0,..]; forged 0xFF00>>8 = 0xFF -> [FF,0,..]
+        assert_eq!(
+            pv.as_deref(),
+            Some(&0xFFu64.to_le_bytes()[..]),
+            "malicious prover should have committed forged q = 0xFF00>>8 = 0xFF"
+        );
+        assert!(
+            res.is_ok(),
+            "N2 BUG REFUTED: SRL shift-amount forge was REJECTED: {res:?}"
+        );
+        println!(
+            "*** N2 L3 GOLD: verifier ACCEPTS SRL 0xFF00>>4 committed as 0xFF00>>8 = 0xFF \
+             (shift-amount `c` decoupled from `c_for_lookup`) ***"
+        );
+    }
