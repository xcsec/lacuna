+    #[test]
+    #[ignore = "N4 negative control: forge WITHOUT the quot_msb dangling-provide fix → must REJECT"]
+    fn e2e_divuw_forge_negative_control() {
+        // Same sign-ext forge + quotient rebalance, but OMIT step (3): leave the
+        // pre-existing quot_msb.populate dangling U16(0) provide unbalanced. The
+        // regional cumulative sum is then −1 at U16Range(0) and the REAL verifier
+        // must reject. This proves the forge's acceptance is due to a FULLY balanced
+        // witness, not a driver artifact.
+        crate::machine::logger::setup_logger();
+        let program = divuw_program();
+        let machine = RiscvMachine::new(SC::test(), RiscvChipType::all_chips(), RISCV_NUM_PVS);
+        let (pk, vk) = machine.setup_keys(&program);
+
+        let hook: forge_hook::Hook = Box::new(|traces: &mut Vec<(String, RowMajorMatrix<F>)>| {
+            divuw_forge_hook_inner(traces, false);
+        });
+
+        let (pv, rejected) = crate::emulator::riscv::emulator::sltu_forge::with_forge(|| {
+            forge_hook::with_hook(hook, || {
+                let witness = ProvingWitness::<SC, C, Vec<u8>>::setup_for_riscv(
+                    program.clone(),
+                    divuw_stdin(),
+                    EmulatorOpts::default(),
+                    pk.clone(),
+                    vk.clone(),
+                );
+                let (proof, _r) = machine.prove_with_shape_report(&witness, None);
+                let pv = proof.pv_stream.clone();
+                let rejected = std::panic::catch_unwind(std::panic::AssertUnwindSafe(|| {
+                    machine.verify(&proof, &vk)
+                }))
+                .map(|r| r.is_err())
+                .unwrap_or(true);
+                (pv, rejected)
+            })
+        });
+        println!("N4 NEG-CONTROL pv={pv:x?} rejected={rejected}");
+        assert_eq!(
+            pv.as_deref(),
+            Some(&0xFFFF_FFFF_0000_0003u64.to_le_bytes()[..]),
+            "neg-control still forges q = 0xFFFFFFFF00000003 (only the byte fix is omitted)"
+        );
+        assert!(
+            rejected,
+            "N4 NEG-CONTROL BROKEN: forge WITHOUT the quot_msb dangling-provide fix was ACCEPTED"
+        );
+        println!(
+            "N4 NEG-CONTROL OK: omitting the U16(0) dangling-provide fix → regional sum ≠ 0 → REJECTED."
+        );
+    }
