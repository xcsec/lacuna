+    #[ignore = "N2 negative control: re-shift WITHOUT the Byte BitRange rebalance → must REJECT"]
+    fn e2e_srl_shiftamt_negative_control() {
+        crate::machine::logger::setup_logger();
+        let program = srl_n2_program();
+        let machine = RiscvMachine::new(SC::test(), RiscvChipType::all_chips(), RISCV_NUM_PVS);
+        let (pk, vk) = machine.setup_keys(&program);
+
+        let hook: forge_hook::Hook = Box::new(|traces: &mut Vec<(String, RowMajorMatrix<F>)>| {
+            srl_n2_forge_hook_inner(traces, false); // omit the Byte rebalance
+        });
+
+        let (pv, rejected) = crate::emulator::riscv::emulator::sltu_forge::with_forge(|| {
+            forge_hook::with_hook(hook, || {
+                let witness = ProvingWitness::<SC, C, Vec<u8>>::setup_for_riscv(
+                    program.clone(),
+                    srl_n2_stdin(),
+                    EmulatorOpts::default(),
+                    pk.clone(),
+                    vk.clone(),
+                );
+                let (proof, _r) = machine.prove_with_shape_report(&witness, None);
+                let pv = proof.pv_stream.clone();
+                let rejected = std::panic::catch_unwind(std::panic::AssertUnwindSafe(|| {
+                    machine.verify(&proof, &vk)
+                }))
+                .map(|r| r.is_err())
+                .unwrap_or(true);
+                (pv, rejected)
+            })
+        });
+        println!("N2 NEG-CONTROL pv={pv:x?} rejected={rejected}");
+        assert_eq!(
+            pv.as_deref(),
+            Some(&0xFFu64.to_le_bytes()[..]),
+            "neg-control still forges q = 0xFF (only the byte rebalance is omitted)"
+        );
+        assert!(
+            rejected,
+            "N2 NEG-CONTROL BROKEN: re-shift WITHOUT the Byte rebalance was ACCEPTED"
+        );
+        println!(
+            "N2 NEG-CONTROL OK: omitting the BitRange rebalance → regional sum ≠ 0 → REJECTED."
+        );
+    }
