+        TARGET_PC.load(Ordering::Relaxed)
+    }
+    pub(crate) fn set_target_pc(pc: u64) {
+        TARGET_PC.store(pc, Ordering::Relaxed);
+    }
+    pub(crate) fn with_forge<R>(patch_cols: bool, patch_comp: bool, body: impl FnOnce() -> R) -> R {
+        ACTIVE.store(true, Ordering::Relaxed);
+        PATCH_COLS.store(patch_cols, Ordering::Relaxed);
+        PATCH_COMP.store(patch_comp, Ordering::Relaxed);
+        TARGET_PC.store(0, Ordering::Relaxed);
