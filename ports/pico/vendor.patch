+    #[test]
+    #[ignore = "HEADLINE N4: full-machine DIVUW quot_msb sign-ext forge; run explicitly in --release"]
+    fn e2e_divuw_forge_accepted() {
+        crate::machine::logger::setup_logger();
+        let program = divuw_program();
+        let machine = RiscvMachine::new(SC::test(), RiscvChipType::all_chips(), RISCV_NUM_PVS);
+        let (pk, vk) = machine.setup_keys(&program);
+
+        // forge_hook: on the DivRem chip's DIVUW(10,3) row, set quot_msb.msb=1 and
+        // quotient[2,3]=0xFFFF (the sign-ext). The executor already forged a to
+        // 0xFFFFFFFF00000003, so a[2,3]=0xFFFF; this makes the chip's sign-ext
+        // constraints (a[2,3]=quot_msb·0xFFFF) hold with the free quot_msb.
+        let hook = Box::new(divuw_forge_hook)
+            as Box<dyn FnMut(&mut Vec<(String, RowMajorMatrix<F>)>) + Send>;
+
+        let (pv, res) = crate::emulator::riscv::emulator::sltu_forge::with_forge(|| {
+            forge_hook::with_hook(hook, || {
+                let witness = ProvingWitness::<SC, C, Vec<u8>>::setup_for_riscv(
+                    program.clone(),
+                    divuw_stdin(),
+                    EmulatorOpts::default(),
+                    pk.clone(),
+                    vk.clone(),
+                );
+                let (proof, _r) = machine.prove_with_shape_report(&witness, None);
+                let pv = proof.pv_stream.clone();
+                println!("DIVUW FORGED pv_stream (before verify): {pv:x?}");
+                let res: Result<(), String> =
+                    match std::panic::catch_unwind(std::panic::AssertUnwindSafe(|| {
+                        machine.verify(&proof, &vk)
+                    })) {
+                        Ok(inner) => inner.map_err(|e| format!("{e:?}")),
+                        Err(e) => {
+                            let m = e
+                                .downcast_ref::<String>()
+                                .cloned()
+                                .or_else(|| e.downcast_ref::<&str>().map(|s| s.to_string()))
+                                .unwrap_or_else(|| "<non-string panic>".into());
+                            Err(format!("verify PANIC: {m}"))
+                        }
+                    };
+                (pv, res)
+            })
+        });
+
+        println!("DIVUW FORGED pv_stream: {pv:x?}");
+        println!("DIVUW FORGED verify:    {res:?}");
+        // honest 3 -> [3,0,0,0,0,0,0,0]; forged 0xFFFFFFFF00000003 -> [3,0,0,0,FF,FF,FF,FF]
+        assert_eq!(
+            pv.as_deref(),
+            Some(&0xFFFF_FFFF_0000_0003u64.to_le_bytes()[..]),
+            "malicious prover should have committed forged q = 0xFFFFFFFF00000003"
+        );
+        assert!(
+            res.is_ok(),
+            "N4 BUG REFUTED: DIVUW quot_msb sign-ext forge was REJECTED: {res:?}"
+        );
+        println!(
+            "*** N4 L3 GOLD: verifier ACCEPTS DIVUW(10,3)=3 committed as 0xFFFFFFFF00000003 \
+             (quot_msb sign-ext unpinned) ***"
+        );
+    }
