+/// Mutate `values[*].a[idx]` (the destination-word limb `idx`) of the first
+/// LessThan trace row to `val`.
+fn set_lt_a(trace: &mut p3_matrix::dense::RowMajorMatrix<KoalaBear>, idx: usize, val: u32) {
+    let row = &mut trace.values[0..NUM_LT_COLS];
+    let cols: &mut LtCols<KoalaBear> = row.borrow_mut();
+    cols.values[0].a[idx] = KoalaBear::from_canonical_u32(val);
+}
