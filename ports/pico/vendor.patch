+    #[test]
+    #[ignore = "diagnostic: reporter DIFF (forged - honest) isolates the SOLE imbalance the SLTU forge causes"]
+    fn e2e_slt_diag_forge_imbalance() {
+        // [reporter-driven] The raw regional reporter is noisy on a 2-chunk ELF
+        // (cross-chunk memory shows as 'imbalanced' identically for honest and
+        // forged). We BASELINE it: compute per-key regional balance for the
+        // HONEST run and the FORGED run, and print only keys whose balance
+        // DIFFERS. That difference is EXACTLY what the forge breaks and what a
+        // repair must clear — driven purely by the reporter, no SLT knowledge.
+        use p3_field::PrimeField32;
+        crate::machine::logger::setup_logger();
+        let program = ltguest_program();
+        let machine = RiscvMachine::new(SC::test(), RiscvChipType::all_chips(), RISCV_NUM_PVS);
+        let (pk, _vk) = machine.setup_keys(&program);
+        let chips = RiscvChipType::<KoalaBear>::all_chips();
+
+        let opts = single_chunk_opts();
+        let honest_recs = ltguest_honest_records(&chips, opts.clone());
+        let forged_recs = ltguest_forged_records(&chips, opts);
+        println!(
+            "FORGE-DIAG chunks: honest={} forged={}",
+            honest_recs.len(),
+            forged_recs.len()
+        );
+        let honest = regional_key_balances(&pk, &chips, &honest_recs);
+        let forged = regional_key_balances(&pk, &chips, &forged_recs);
+
+        // KoalaBear prime = 2^31 - 2^24 + 1.
+        let p: i64 = 2130706433;
+        let to_signed = |x: F| {
+            let v = x.as_canonical_u32() as i64;
+            if v > p / 2 {
+                v - p
+            } else {
+                v
+            }
+        };
+
+        // All keys present in either map.
+        let mut keys: std::collections::BTreeSet<_> = honest.keys().cloned().collect();
+        keys.extend(forged.keys().cloned());
+
+        use crate::machine::lookup::LookupType;
+        use p3_field::FieldAlgebra;
+        let mut diffs = 0usize;
+        let mut out_of_range = 0usize;
+        println!("FORGE-DIAG (forged - honest) FULL regional imbalance DIFF:");
+        for k in &keys {
+            let h = honest.get(k).copied().unwrap_or(F::ZERO);
+            let f = forged.get(k).copied().unwrap_or(F::ZERO);
+            let d = f - h;
+            if to_signed(d) != 0 {
+                diffs += 1;
+                // A Byte/U16Range key whose value >= 2^16 is STRUCTURALLY
+                // unprovidable (the Byte table only ranges over [0,2^16)). That
+                // is the smoking gun: a gadget emitted an out-of-range u16 check.
+                let is_u16 = k.kind == LookupType::Byte
+                    && k.values.len() >= 2
+                    && k.values[0].as_canonical_u32() == 8;
+                let val = if is_u16 {
+                    k.values[1].as_canonical_u32()
+                } else {
+                    0
+                };
+                if is_u16 && val >= (1 << 16) {
+                    out_of_range += 1;
+                    println!(
+                        "  *** OUT-OF-U16-RANGE *** DIFF {:+} for {}",
+                        to_signed(d),
+                        k
+                    );
+                }
+            }
+        }
+        println!(
+            "FORGE-DIAG FULL: {diffs} keys changed; {out_of_range} are OUT-OF-U16-RANGE \
+             (genuine unbalanceable imbalances; the rest are even value-ripples)."
+        );
+
+        // [reporter-driven localization, NO SLT knowledge] Attribute the
+        // out-of-domain U16Range key(s) to a CHIP: iterate chips and ask the
+        // reporter which one emits a U16Range looking whose value >= 2^16. The
+        // Byte table can never provide it, so whichever chip looks it up is the
+        // culprit. This pinpoints "LessThan" mechanically.
+        {
+            use crate::machine::{
+                chip::ChipBehavior, debug::lookups::DebugLookup, lookup::LookupScope,
+            };
+            for chip in &chips {
+                for chunk in &forged_recs {
+                    let data = DebugLookup::<F>::debug_lookups::<SC, C>(
+                        &pk,
+                        chip,
+                        chunk,
+                        LookupScope::Regional,
+                        None,
+                    )
+                    .lookup_data;
+                    for (k, (_, bal)) in data {
+                        let is_u16 = k.kind == LookupType::Byte
+                            && k.values.len() >= 2
+                            && k.values[0].as_canonical_u32() == 8;
+                        if is_u16
+                            && k.values[1].as_canonical_u32() >= (1 << 16)
+                            && to_signed(bal) != 0
+                        {
+                            println!(
+                                "  REPORTER-ATTRIBUTION: chip '{}' emits unprovidable {} \
+                                 (balance {:+}) -> THIS is the chip to repair.",
+                                chip.name(),
+                                k,
+                                to_signed(bal)
+                            );
+                        }
+                    }
+                }
+            }
+        }
+
+        // Chunk-0-only diff: the LT event lives in the EXECUTION chunk; the
+        // memory-finalize + public-value hashing (the even ±2 ripples) live in
+        // the separate finalize chunk. Restricting to chunk 0 removes that noise
+        // and should leave ONLY the LT gadget's imbalance.
+        let honest0 = regional_key_balances(&pk, &chips, &honest_recs[..1]);
+        let forged0 = regional_key_balances(&pk, &chips, &forged_recs[..1]);
+        let mut keys0: std::collections::BTreeSet<_> = honest0.keys().cloned().collect();
+        keys0.extend(forged0.keys().cloned());
+        let mut diffs0 = 0usize;
+        for k in keys0 {
+            let d = forged0.get(&k).copied().unwrap_or(F::ZERO)
+                - honest0.get(&k).copied().unwrap_or(F::ZERO);
+            if to_signed(d) != 0 {
+                diffs0 += 1;
+            }
+        }
+        println!(
+            "FORGE-DIAG CHUNK-0-ONLY (execution chunk): {diffs0} key(s) changed — chunk isolation \
+             does NOT denoise (the committed value ripples through in-chunk memory/hash U16 checks). \
+             The robust discriminator is the OUT-OF-DOMAIN value + per-chip attribution above."
+        );
+    }
+
+    /// Reporter-guided LOCAL repair applied inside the real prove seam. For each
+    /// LessThan row, recompute the gadget's range-check diff from the row's OWN
+    /// comparison_limbs + bit; if it is out of the u16 range [0,2^16) (exactly
+    /// the condition the reporter flags), reset `bit` to the value that lands
+    /// diff back in range. `cols.a` (the forged output word) is left untouched.
+    fn repair_lt_gadget_bit(traces: &mut Vec<(String, RowMajorMatrix<F>)>) {
+        use p3_field::PrimeField32;
+        use p3_matrix::Matrix;
+        let Some((_, trace)) = traces.iter_mut().find(|(n, _)| n == "LessThan") else {
+            return;
+        };
+        let height = trace.height();
+        let mut repaired = 0usize;
+        for row in 0..height {
+            let base = row * NUM_LT_COLS;
+            let slice = &mut trace.values[base..base + NUM_LT_COLS];
+            let cols: &mut LtCols<F> = slice.borrow_mut();
+            let g = &mut cols.values[0].lt_signed.result;
+            let cl0 = g.comparison_limbs[0].as_canonical_u32() as i64;
+            let cl1 = g.comparison_limbs[1].as_canonical_u32() as i64;
+            let bit = g.bit.as_canonical_u32() as i64;
+            let diff = (cl0 - cl1) + bit * (1 << 16);
+            if !(0..(1 << 16)).contains(&diff) {
+                // Local completion: the gadget's range-check is unsatisfiable at
+                // this row. The only free choice is `bit`; pick the one that puts
+                // diff = (cl0-cl1)+bit*2^16 into [0,2^16).
+                let want_bit = if cl0 - cl1 < 0 { 1u32 } else { 0u32 };
+                g.bit = F::from_canonical_u32(want_bit);
+                repaired += 1;
+            }
+        }
+        eprintln!("REPAIR-HOOK: fixed {repaired} out-of-range LT gadget bit(s)");
+    }
+
+    #[test]
+    #[ignore = "ROUTE A: reporter-guided local repair recovers a verifier-accepted SLTU forge; run in --release"]
+    fn e2e_slt_repair_recovers() {
+        use crate::emulator::riscv::emulator::sltu_forge;
+        crate::machine::logger::setup_logger();
+        let program = ltguest_program();
+        let machine = RiscvMachine::new(SC::test(), RiscvChipType::all_chips(), RISCV_NUM_PVS);
+        let (pk, vk) = machine.setup_keys(&program);
+
+        // Nest BOTH test seams:
+        //   * sltu_forge  — malicious executor sets event.a=1 (cross-chip forge).
+        //   * forge_hook  — our LOCAL gadget repair, applied between generate_main
+        //                   and commit_main inside the genuine prove pipeline.
+        let (pv, res) = sltu_forge::with_forge(|| {
+            let hook: forge_hook::Hook = Box::new(repair_lt_gadget_bit);
+            forge_hook::with_hook(hook, || {
+                let witness = ProvingWitness::<SC, C, Vec<u8>>::setup_for_riscv(
+                    program.clone(),
+                    ltguest_stdin(),
+                    EmulatorOpts::default(),
+                    pk.clone(),
+                    vk.clone(),
+                );
+                let (proof, _r) = machine.prove_with_shape_report(&witness, None);
+                let pv = proof.pv_stream.clone();
+                println!("REPAIR forged pv_stream (before verify): {pv:x?}");
+                let prev = std::panic::take_hook();
+                std::panic::set_hook(Box::new(|_| {}));
+                let res: Result<(), String> =
+                    match std::panic::catch_unwind(std::panic::AssertUnwindSafe(|| {
+                        machine.verify(&proof, &vk)
+                    })) {
+                        Ok(inner) => inner.map_err(|e| format!("{e:?}")),
+                        Err(_) => Err("verify panicked (bus/constraint failure)".to_string()),
+                    };
+                std::panic::set_hook(prev);
+                (pv, res)
+            })
+        });
+
+        println!("REPAIR pv_stream: {pv:x?}");
+        println!("REPAIR verify:    {res:?}");
+        assert_eq!(
+            pv.as_deref(),
+            Some(&[1u8, 0, 0, 0][..]),
+            "sanity: executor forge must have committed the forged c=1"
+        );
+        assert!(
+            res.is_ok(),
+            "ROUTE A FAILED to recover: repaired forged witness was REJECTED: {res:?}"
+        );
+        println!(
+            "ROUTE A SUCCESS: reporter-guided LOCAL repair recovered a globally-consistent \
+             witness — verifier ACCEPTED committed (5<3)=1 (a[0] forged) with ALL lookups ON."
+        );
+    }
