+    // ========================================================================
+    // BUG (1) — pico DivRem loose remainder bound (`abs(rem) <= abs(c)`).
+    //
+    // The DivRem AIR checks `b = c*quotient + remainder` and `abs(remainder) <
+    // abs(c)` via LtWordU16Gadget. But that gadget only forces `<` when the two
+    // words DIFFER; when they are EQUAL (all limb flags 0) it admits equality,
+    // so the effective bound is `abs(remainder) <= abs(c)`. For a divisible case
+    // 8/2 (honest quotient=4, remainder=0) this admits the OUT-OF-IMAGE boundary
+    // decomposition quotient=3, remainder=2 (=divisor): 2*3+2 = 8 and 2 <= 2.
+    //
+    // A malicious executor commits the forged quotient 3 (register/store/COMMIT
+    // all carry 3); the DivRem trace row is repaired to the boundary
+    // decomposition and the Byte range-check multiplicities are rebalanced by
+    // exactly the delta the changed limbs cause (computed by mirroring
+    // divrem/traces.rs). The GENUINE prove+verify then ACCEPTS committed 8/2 = 3.
+    // ========================================================================
+
+    const DIVU_ELF_PATH: &str =
+        "<LACUNA_GUEST_ELF_DIR>/divu-elf";
+
+    fn divu_program() -> Arc<Program> {
+        let elf = std::fs::read(DIVU_ELF_PATH).expect("read divu elf");
+        Compiler::new(SourceType::RISCV, &elf)
+            .expect("parse divu elf")
+            .compile()
+    }
+
+    fn divu_stdin() -> EmulatorStdin<Program, Vec<u8>> {
+        // a=8, b=2  ->  honest c = 8/2 = 4  (single 64-bit DIVU, operands b=8,c=2)
+        let mut b = EmulatorStdin::<Program, Vec<u8>>::new_builder::<SC>();
+        b.write(&8u64);
+        b.write(&2u64);
+        b.finalize().0
+    }
+
+    #[test]
+    #[ignore = "heavy: full STARK prove+verify of the divu ELF; run explicitly in --release"]
+    fn e2e_divu_honest_baseline() {
+        crate::machine::logger::setup_logger();
+        let program = divu_program();
+        let machine = RiscvMachine::new(SC::test(), RiscvChipType::all_chips(), RISCV_NUM_PVS);
+        let (pk, vk) = machine.setup_keys(&program);
+        let witness = ProvingWitness::<SC, C, Vec<u8>>::setup_for_riscv(
+            program.clone(),
+            divu_stdin(),
+            EmulatorOpts::default(),
+            pk,
+            vk.clone(),
+        );
+        let (proof, _r) = machine.prove_with_shape_report(&witness, None);
+        println!("DIVU honest pv_stream: {:x?}", proof.pv_stream);
+        machine
+            .verify(&proof, &vk)
+            .expect("divu honest must verify");
+        assert_eq!(
+            proof.pv_stream.as_deref(),
+            Some(&[4u8, 0, 0, 0][..]),
+            "honest c=8/2=4"
+        );
+        println!("E2E DIVU BASELINE OK: commits c=4, verifies with all lookups ON.");
+    }
