+fn emulate_first_record(
+    program: Arc<Program>,
+    chips: &[MetaChip<KoalaBear, RiscvChipType<KoalaBear>>],
+) -> crate::emulator::riscv::record::EmulationRecord {
+    let stdin_builder = EmulatorStdin::<Program, Vec<u8>>::new_builder::<KoalaBearPoseidon2>();
+    let (stdin, _proofs) = stdin_builder.finalize();
+    let all = test_rv64_emulate(program, stdin);
+    let mut record = all.first().cloned().unwrap();
+    crate::chips::tests::run_extra_records(chips, &mut record);
+    record
+}
