+            (pv, res)
+        });
+        println!(
+            "N2 HONEST SRL pv={:x?} verify={:?}",
+            honest_res.0, honest_res.1
+        );
+
+        // Forged: executor forge + N2 hook, in-hook residual on committed trace.
+        let hook: forge_hook::Hook = {
+            let pk = pk_arc.clone();
+            let chips = chips_arc.clone();
+            Box::new(move |traces: &mut Vec<(String, RowMajorMatrix<F>)>| {
+                if !traces.iter().any(|(n, _)| n == "ShiftRight") {
+                    srl_n2_forge_hook(traces);
+                    return;
+                }
+                let before = regional_balance_from_mut_traces(&pk, &chips, traces.as_slice());
+                srl_n2_forge_hook(traces);
+                let after = regional_balance_from_mut_traces(&pk, &chips, traces.as_slice());
+                let nzb = before.values().filter(|v| !v.is_zero()).count();
+                let nza = after.values().filter(|v| !v.is_zero()).count();
+                eprintln!("[N2 HOOK] nz_before={nzb} nz_after={nza}");
+                for (k, v) in &after {
+                    if !v.is_zero() {
+                        eprintln!("[N2 HOOK] ABS-RESIDUAL {:+} for {}", to_signed_kb(*v), k);
+                    }
