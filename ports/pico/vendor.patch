+/// N1 (memory `addr_aligned` unconstrained) forge driver.
+///
+/// The read_write chip keys the offline-memory argument by `addr_aligned` (the 8-aligned
+/// access address) but only ties `addr_word` (= rs1+imm) to the operands + every guard
+/// (stack-guard, u16 range checks, offset binding). NOTHING equates `addr_aligned` to
+/// `addr_word` (`read_write/columns.rs:40`: literal "TODO: add constraints to fix soundness").
+///
+/// The forge exploits exactly that: the executor keeps `addr = X = rs1+imm` (so `addr_word=X`
+/// passes all guards) but physically reads the adjacent dword `Y = X-8` (`arr[0]`), and
+/// trace-gen points `addr_aligned` at `Y`. The memory argument balances because `Y` is
+/// genuinely read; the load returns `Y`'s value, which propagates to `rd`→commit. With
+/// `patch=false` (neg-control) trace-gen leaves `addr_aligned=X` while the record is `Y`'s
+/// value ⇒ the memory-bus tuple `[ts, X, V_Y]` matches neither address ⇒ regional imbalance
+/// ⇒ REJECT — isolating the free `addr_aligned` as the sole cause.
+#[cfg(test)]
+pub(crate) mod n1_forge {
+    use std::sync::atomic::{AtomicBool, AtomicU64, Ordering};
+    static ACTIVE: AtomicBool = AtomicBool::new(false);
+    static PATCH: AtomicBool = AtomicBool::new(false);
+    static FIRED: AtomicBool = AtomicBool::new(false);
+    /// PC of the redirected load instruction, recorded by the executor when it fires. The
+    /// trace-gen override matches THIS pc only (0 = unset), so it patches exactly the one
+    /// redirected row — pc is unique per instruction, unlike the address (which can collide
+    /// with the commit-path load that reads SECRET back).
+    static REDIRECT_PC: AtomicU64 = AtomicU64::new(0);
+    pub(crate) fn set_redirect_pc(pc: u64) {
+        REDIRECT_PC.store(pc, Ordering::Relaxed);
+    }
+    pub(crate) fn redirect_pc() -> u64 {
+        REDIRECT_PC.load(Ordering::Relaxed)
+    }
+    /// dword held at the true load address X (`arr[1]`); triggers the one-shot redirect.
+    pub(crate) const N1_PUBLIC: u64 = 0x2222_2222_2222_2222;
+    /// dword held at Y=X-8 (`arr[0]`); the value the redirect reads and commits.
+    pub(crate) const N1_SECRET: u64 = 0x1111_1111_1111_1111;
+    pub(crate) fn active() -> bool {
+        ACTIVE.load(Ordering::Relaxed)
+    }
+    pub(crate) fn patch_addr() -> bool {
+        PATCH.load(Ordering::Relaxed)
+    }
+    pub(crate) fn fired() -> bool {
+        FIRED.load(Ordering::Relaxed)
+    }
+    pub(crate) fn set_fired() {
+        FIRED.store(true, Ordering::Relaxed);
+    }
+    /// Run `body` with the N1 forge active. `patch` = also override `addr_aligned` (the full
+    /// forge); `false` = executor-redirect only (neg-control). Cleared on return / panic.
+    pub(crate) fn with_forge<R>(patch: bool, body: impl FnOnce() -> R) -> R {
+        ACTIVE.store(true, Ordering::Relaxed);
+        PATCH.store(patch, Ordering::Relaxed);
+        FIRED.store(false, Ordering::Relaxed);
+        REDIRECT_PC.store(0, Ordering::Relaxed);
+        struct Clear;
+        impl Drop for Clear {
+            fn drop(&mut self) {
+                ACTIVE.store(false, Ordering::Relaxed);
+                PATCH.store(false, Ordering::Relaxed);
+                FIRED.store(false, Ordering::Relaxed);
+                REDIRECT_PC.store(0, Ordering::Relaxed);
+            }
+        }
+        let _clear = Clear;
+        body()
+    }
+}
