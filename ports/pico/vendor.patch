+/// TEST-ONLY forge seam used by the precompile lookup-forge driver
+/// (`chips::precompiles::precompile_lookup_forge`). A GLOBAL mutation hook is
+/// consulted inside the REAL `RiscvMachine::prove_record` between
+/// `generate_main` and `commit_main`, so a single witness cell can be overridden
+/// inside the genuine multi-chunk ensemble (lookups ON, real challenger /
+/// regional balancing / public values / shape).
+///
+/// It is GLOBAL (not thread-local) because the real `prove_local` proves chunks
+/// on rayon worker threads; a thread-local set on the test thread would not be
+/// seen there. Tests run single-threaded (`--test-threads=1`) and the install
+/// guard holds a global lock, so only one forge is ever active at a time. The
+/// closure operates on `Vec<(String, RowMajorMatrix<KoalaBear>)>`; all test
+/// machines use KoalaBear and the cast in `apply` is a no-op when
+/// `SC::Val == KoalaBear`.
+#[cfg(test)]
+pub(crate) mod forge_hook {
+    use p3_field::PrimeField32;
+    use p3_koala_bear::KoalaBear;
+    use p3_matrix::dense::RowMajorMatrix;
+    use std::sync::Mutex;
+
+    type KbTraces = Vec<(String, RowMajorMatrix<KoalaBear>)>;
+    pub type Hook = Box<dyn FnMut(&mut KbTraces) + Send>;
+
+    static HOOK: Mutex<Option<Hook>> = Mutex::new(None);
+    // Serializes forge tests so only one hook is installed at a time.
+    static INSTALL_LOCK: Mutex<()> = Mutex::new(());
+
+    /// Install a mutation hook for the duration of `body`. Cleared on return
+    /// (even on panic via the guard).
+    pub(crate) fn with_hook<R>(hook: Hook, body: impl FnOnce() -> R) -> R {
+        let _serialize = INSTALL_LOCK.lock().unwrap_or_else(|e| e.into_inner());
+        *HOOK.lock().unwrap() = Some(hook);
+        struct Clear;
+        impl Drop for Clear {
+            fn drop(&mut self) {
+                *HOOK.lock().unwrap() = None;
+            }
+        }
+        let _clear = Clear;
+        body()
+    }
+
+    pub(crate) fn is_active() -> bool {
+        HOOK.lock().unwrap().is_some()
+    }
+
+    /// Apply the installed hook to a generated main-trace list. `F: PrimeField32`
+    /// is the machine's value type; tests use KoalaBear, so we reinterpret the
+    /// `&mut Vec<(String, RowMajorMatrix<F>)>` as KoalaBear traces. Asserts the
+    /// field has KoalaBear's layout to fail loudly otherwise.
+    pub(crate) fn apply<F: PrimeField32>(traces: &mut Vec<(String, RowMajorMatrix<F>)>) {
+        assert_eq!(
+            std::mem::size_of::<F>(),
+            std::mem::size_of::<KoalaBear>(),
+            "forge_hook only supports KoalaBear test machines"
+        );
+        // SAFETY: tests instantiate the machine with SC::Val == KoalaBear, which
+        // has identical layout/size to F here. The hook never escapes this call.
+        let kb: &mut KbTraces =
+            unsafe { &mut *(traces as *mut Vec<(String, RowMajorMatrix<F>)> as *mut KbTraces) };
+        if let Some(hook) = HOOK.lock().unwrap().as_mut() {
+            hook(kb);
+        }
+    }
+}
