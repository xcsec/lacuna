+/// AUDIT POC: VolatileBoundaryAir does NOT constrain `initial_data == 0`.
+/// A malicious prover can declare the initial (uninitialized) value of a
+/// volatile cell to be an arbitrary nonzero value. The spec
+/// (controller/mod.rs:71) is that uninitialized volatile memory is zero.
+/// Here we hand-build a boundary trace with `initial_data = 5` for a single
+/// touched address and a matching dummy that "reads" that forged initial value
+/// off the memory bus. If verification succeeds, the boundary AIR placed no
+/// constraint pinning initial_data to zero.
+#[test]
+fn poc_forge_nonzero_initial_data() {
+    use crate::system::memory::volatile::VolatileBoundaryCols;
+    use openvm_circuit_primitives::TraceSubRowGenerator;
+    use openvm_stark_backend::p3_air::BaseAir;
+    use std::borrow::BorrowMut;
+
+    const MEMORY_BUS: BusIndex = 1;
+    const RANGE_CHECKER_BUS: BusIndex = 3;
+    const LIMB_BITS: usize = 15;
+    const DECOMP: usize = 8;
+    let memory_bus = MemoryBus::new(MEMORY_BUS);
+
+    let range_bus = VariableRangeCheckerBus::new(RANGE_CHECKER_BUS, DECOMP);
+    let range_checker = Arc::new(VariableRangeCheckerChip::new(range_bus));
+
+    // addr_space_max_bits=2, pointer_max_bits=LIMB_BITS
+    let boundary_chip =
+        VolatileBoundaryChip::<Val>::new(memory_bus, 2, LIMB_BITS, range_checker.clone());
+    let boundary_air = Arc::new(boundary_chip.air.clone()) as AirRef<_>;
+    let width = BaseAir::<Val>::width(&boundary_chip.air);
+
+    // One touched address: (addr_space=1, pointer=7).
+    let addr_space: u32 = 1;
+    let pointer: u32 = 7;
+    let forged_initial: u32 = 5; // <-- forged nonzero "uninitialized" value
+    let final_data: u32 = 5;
+    let final_ts: u32 = 100;
+
+    // Build a 2-row boundary trace (1 valid + 1 padding).
+    let mut rows = vec![Val::ZERO; 2 * width];
+    {
+        let row: &mut VolatileBoundaryCols<Val> = rows[..width].borrow_mut();
+        // addr_space_max_bits=2 -> single limb of 2 bits
+        range_checker.decompose(addr_space, 2, &mut row.addr_space_limbs);
+        range_checker.decompose(pointer, LIMB_BITS, &mut row.pointer_limbs);
+        row.initial_data = Val::from_u32(forged_initial);
+        row.final_data = Val::from_u32(final_data);
+        row.final_timestamp = Val::from_u32(final_ts);
+        row.is_valid = Val::ONE;
+    }
+    // Dummy range check on last row due to wraparound (next.is_valid==0 so no lt constraint).
+    {
+        let mut out = Val::ZERO;
+        let row: &mut VolatileBoundaryCols<Val> = rows[width..].borrow_mut();
+        boundary_chip.air.addr_lt_air.0.generate_subrow(
+            (
+                range_checker.as_ref(),
+                &[Val::ZERO, Val::ZERO],
+                &[Val::ZERO, Val::ZERO],
+            ),
+            ((&mut row.addr_lt_aux).into(), &mut out),
+        );
+    }
+    let boundary_trace = Arc::new(RowMajorMatrix::new(rows, width));
+
+    // Dummy that RECEIVES the forged initial value off the bus (simulates a CPU
+    // "read" of the uninitialized cell returning 5), then SENDS final back.
+    // init dummy: count=is_valid, fields [addr_space, pointer, data, timestamp]
+    let init_memory_dummy_air = DummyInteractionAir::new(4, false, MEMORY_BUS);
+    let final_memory_dummy_air = DummyInteractionAir::new(4, true, MEMORY_BUS);
+
+    let init_memory_trace = Arc::new(RowMajorMatrix::new(
+        vec![
+            Val::ONE,
+            Val::from_u32(addr_space),
+            Val::from_u32(pointer),
+            Val::from_u32(forged_initial), // receive 5 at ts 0
+            Val::ZERO,
+            // padding row
+            Val::ZERO,
+            Val::ZERO,
+            Val::ZERO,
+            Val::ZERO,
+            Val::ZERO,
+        ],
+        5,
+    ));
+    let final_memory_trace = Arc::new(RowMajorMatrix::new(
+        vec![
+            Val::ONE,
+            Val::from_u32(addr_space),
+            Val::from_u32(pointer),
+            Val::from_u32(final_data),
+            Val::from_u32(final_ts),
+            Val::ZERO,
+            Val::ZERO,
+            Val::ZERO,
+            Val::ZERO,
+            Val::ZERO,
+        ],
+        5,
+    ));
+
+    BabyBearPoseidon2Engine::run_test_fast(
+        vec![
+            boundary_air,
+            Arc::new(range_checker.air),
+            Arc::new(init_memory_dummy_air),
+            Arc::new(final_memory_dummy_air),
+        ],
+        vec![
+            AirProvingContext::simple_no_pis(boundary_trace),
+            range_checker.generate_proving_ctx(()),
+            AirProvingContext::simple_no_pis(init_memory_trace),
+            AirProvingContext::simple_no_pis(final_memory_trace),
+        ],
+    )
+    .expect("FORGERY ACCEPTED: boundary AIR did not pin initial_data=0");
+}
