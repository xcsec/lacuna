+    use openvm_circuit_primitives::TraceSubRowGenerator;
+    use openvm_stark_backend::p3_air::BaseAir;
+    use std::borrow::BorrowMut;
+
+    const MEMORY_BUS: BusIndex = 1;
+    const RANGE_CHECKER_BUS: BusIndex = 3;
+    const LIMB_BITS: usize = 15;
+    const DECOMP: usize = 8;
+    let memory_bus = MemoryBus::new(MEMORY_BUS);
+
+    let range_bus = VariableRangeCheckerBus::new(RANGE_CHECKER_BUS, DECOMP);
+    let range_checker = Arc::new(VariableRangeCheckerChip::new(range_bus));
+
+    let boundary_chip =
+        VolatileBoundaryChip::<Val>::new(memory_bus, 2, LIMB_BITS, range_checker.clone());
+    let boundary_air = Arc::new(boundary_chip.air.clone()) as AirRef<_>;
+    let width = BaseAir::<Val>::width(&boundary_chip.air);
+
+    let addr_space: u32 = 1;
+    let pointer: u32 = 7;
+    let honest_initial: u32 = 0; // honest: boundary sends 0
+    let read_value: u32 = 5; // but the CPU read claims it got 5
+    let final_data: u32 = 5;
+    let final_ts: u32 = 100;
+
+    let mut rows = vec![Val::ZERO; 2 * width];
+    {
+        let row: &mut VolatileBoundaryCols<Val> = rows[..width].borrow_mut();
+        range_checker.decompose(addr_space, 2, &mut row.addr_space_limbs);
+        range_checker.decompose(pointer, LIMB_BITS, &mut row.pointer_limbs);
+        row.initial_data = Val::from_u32(honest_initial);
+        row.final_data = Val::from_u32(final_data);
+        row.final_timestamp = Val::from_u32(final_ts);
+        row.is_valid = Val::ONE;
+    }
+    {
+        let mut out = Val::ZERO;
+        let row: &mut VolatileBoundaryCols<Val> = rows[width..].borrow_mut();
+        boundary_chip.air.addr_lt_air.0.generate_subrow(
+            (
+                range_checker.as_ref(),
+                &[Val::ZERO, Val::ZERO],
+                &[Val::ZERO, Val::ZERO],
+            ),
+            ((&mut row.addr_lt_aux).into(), &mut out),
+        );
+    }
+    let boundary_trace = Arc::new(RowMajorMatrix::new(rows, width));
+
+    let init_memory_dummy_air = DummyInteractionAir::new(4, false, MEMORY_BUS);
+    let final_memory_dummy_air = DummyInteractionAir::new(4, true, MEMORY_BUS);
+
+    // CPU read dummy receives 5 -- but boundary only sent 0 -> bus imbalance.
+    let init_memory_trace = Arc::new(RowMajorMatrix::new(
+        vec![
+            Val::ONE,
+            Val::from_u32(addr_space),
+            Val::from_u32(pointer),
+            Val::from_u32(read_value), // receive 5, no matching send of 5 at ts 0
+            Val::ZERO,
+            Val::ZERO,
+            Val::ZERO,
+            Val::ZERO,
+            Val::ZERO,
+            Val::ZERO,
+        ],
+        5,
+    ));
+    let final_memory_trace = Arc::new(RowMajorMatrix::new(
+        vec![
+            Val::ONE,
+            Val::from_u32(addr_space),
+            Val::from_u32(pointer),
+            Val::from_u32(final_data),
+            Val::from_u32(final_ts),
+            Val::ZERO,
+            Val::ZERO,
+            Val::ZERO,
+            Val::ZERO,
+            Val::ZERO,
+        ],
+        5,
+    ));
+
+    // run_test_fast panics (LogUp multiset equality check) on bus imbalance
+    // rather than returning Err, so catch the unwind.
+    let prev_hook = std::panic::take_hook();
+    std::panic::set_hook(Box::new(|_| {}));
+    let outcome = std::panic::catch_unwind(std::panic::AssertUnwindSafe(|| {
+        BabyBearPoseidon2Engine::run_test_fast(
+            vec![
+                boundary_air,
+                Arc::new(range_checker.air),
+                Arc::new(init_memory_dummy_air),
